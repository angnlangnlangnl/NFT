                    </div>
                </div>
            </div>
        </div>

        <!-- 开盒弹窗 -->
        <div class="modal-overlay" id="modalOverlay">
            <div class="modal-box">
                <div class="result-icon" id="resultIcon">🎁</div>
                <div class="result-name" id="resultName"></div>
                <div class="result-rarity" id="resultRarity"></div>
                <button class="btn-close" onclick="closeModal()">确 定</button>
            </div>
        </div>

        <!-- 底部导航 -->
        <div class="bottom-nav">
            <a href="index.html" class="nav-item">
                <i class="fas fa-gem nav-icon"></i>
                <span class="nav-nft">挑选NFT</span>
            </a>
            <a href="entertainment.html" class="nav-item active">
                <i class="fas fa-gamepad nav-icon"></i>
                <span class="nav-entertainment">娱乐</span>
            </a>
            <a href="liquidity.html" class="nav-item">
                <i class="fas fa-store nav-icon"></i>
