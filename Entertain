                <div class="price"><i class="fab fa-ethereum"></i> 0.005 BNB</div>
                <button class="btn-mint btn-mint-text" onclick="event.stopPropagation(); handleMint('典藏盲盒')">Mint 抽取</button>
                <p class="remaining">剩余 612/1000</p>
            </div>

            <!-- 至尊礼盒 -->
            <div class="box-card" onclick="openBox('至尊礼盒', '🐼', '大熊猫', '传说', '#0007')">
                <div class="box-icon">
                    👑
                    <div class="shimmer"></div>
                    <span class="number-tag">NO.13</span>
                </div>
                <h3 class="box-supreme-title">至尊礼盒</h3>
                <p class="desc box-supreme-desc">必得史诗或传说动物卡牌</p>
                <div class="price"><i class="fab fa-ethereum"></i> 0.02 BNB</div>
                <button class="btn-mint btn-mint-text" onclick="event.stopPropagation(); handleMint('至尊礼盒')">Mint 抽取</button>
                <p class="remaining">剩余 89/200</p>
            </div>

            <!-- 抽取历史 -->
            <div class="history-section">
                <div class="history-title">
                    <i class="fas fa-history"></i>
                    <span class="history-label">抽取记录</span>
                </div>
                <div class="history-list" id="historyList">
                    <div class="history-item">
                        <span class="h-icon">🦊</span>
                        <div class="h-info">
                            <div class="h-name">藏狐</div>
