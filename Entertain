            <a href="invite.html" class="nav-item">
                <i class="fas fa-heart nav-icon"></i>
                <span class="nav-collection">收藏</span>
            </a>
            <a href="ecosystem.html" class="nav-item">
                <i class="fas fa-globe nav-icon"></i>
                <span class="nav-ecosystem">生态</span>
            </a>
        </div>
    </div>

    <script>
        // ======================== 多语言翻译数据 ========================
        const translations = {
            cn: {
                langBtn: '🇨🇳 CN',
                navNFT: '挑选NFT',
                navEntertainment: '娱乐',
                navMarket: '市场',
