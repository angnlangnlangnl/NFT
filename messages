<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>讯息 · 消息中心</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/5.7.2/ethers.umd.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        :root {
            --bg-color: #0d1a14;
            --card-bg: rgba(19, 32, 22, 0.85);
            --border-color: rgba(180, 145, 70, 0.25);
            --text-primary: #FFFFFF;
            --text-primary-soft: #f0e6d2;
            --text-secondary: #b8a47b;
            --gold-light: #f8ecc9;
            --gold-main: #d6b878;
            --gold-deep: #9e7a3a;
            --gold-glow: #dbb45c;
        }

        body {
            background-color: var(--bg-color);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            height: 100dvh;
            overflow: hidden;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            color: var(--text-primary);
            background-image: 
                radial-gradient(circle at 20% 10%, rgba(180, 145, 70, 0.12) 0%, transparent 35%),
                radial-gradient(circle at 80% 80%, rgba(220, 195, 140, 0.08) 0%, transparent 40%);
        }

        .app-container {
            width: 100%;
            max-width: 420px;
            height: 100%;
            max-height: 100vh;
            max-height: 100dvh;
            background: radial-gradient(circle at 50% 10%, #1a2e1f 0%, #0d1a14 100%);
            border-radius: 20px;
            box-shadow: 0 0 40px rgba(180, 145, 70, 0.15);
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
        }

        .app-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: radial-gradient(rgba(180, 145, 70, 0.06) 1px, transparent 1px);
            background-size: 40px 40px;
            opacity: 0.5;
            z-index: 0;
            pointer-events: none;
            border-radius: 20px;
        }

        .scroll-area {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
            -webkit-overflow-scrolling: touch;
            overscroll-behavior: contain;
            position: relative;
            z-index: 1;
        }

        /* 头部样式 */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 15px;
            position: relative;
        }

        .logo-area {
            display: flex;
            align-items: center;
            font-size: 18px;
            font-weight: 700;
            color: var(--gold-main);
            letter-spacing: 0.5px;
            text-shadow: 0 0 15px rgba(180, 145, 70, 0.4);
        }

        .logo-area .logo-icon {
            font-size: 28px;
            margin-right: 8px;
        }

        .header-controls {
            display: flex;
            gap: 8px;
            align-items: center;
            position: relative;
        }

        .lang-btn {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .lang-btn.active {
            background: rgba(180, 145, 70, 0.1);
            border-color: var(--gold-main);
            color: var(--gold-glow);
        }

        .lang-dropdown {
            display: none;
            position: absolute;
            top: 38px;
            right: 0;
            background: rgba(13, 26, 20, 0.97);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 12px;
            width: 200px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.8);
            z-index: 999;
            flex-direction: column;
            gap: 6px;
            max-height: 300px;
            overflow-y: auto;
        }

        .lang-dropdown.open {
            display: flex;
        }

        .lang-option {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            border-radius: 6px;
            color: var(--text-primary-soft);
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .lang-option:hover {
            background: rgba(197, 164, 85, 0.15);
            color: var(--gold-light);
        }

        .lang-option .code {
            color: var(--text-secondary);
            font-size: 12px;
            font-weight: 500;
            margin-left: 8px;
        }

        .connect-btn {
            background: transparent;
            border: 1px solid rgba(214, 184, 120, 0.4);
            color: var(--gold-glow);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            box-shadow: 0 0 15px rgba(180, 145, 70, 0.08);
            transition: all 0.3s;
            white-space: nowrap;
        }

        .connect-btn:hover:not(:disabled) {
            box-shadow: 0 0 25px rgba(180, 145, 70, 0.25);
            background: rgba(180, 145, 70, 0.08);
        }

        .connect-btn.connected {
            background: rgba(180, 145, 70, 0.12);
            border-color: var(--gold-glow);
            color: var(--gold-light);
        }

        .connect-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* 页面标题 */
        .page-title {
            text-align: center;
            margin-bottom: 20px;
        }

        .page-title h2 {
            font-size: 26px;
            font-weight: 700;
            background: linear-gradient(180deg, #f5e3b3 0%, #c5a455 60%, #8a6327 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 0 20px rgba(180, 145, 70, 0.5);
            margin-bottom: 6px;
        }

        .page-title p {
            color: #b8a16a;
            font-size: 13px;
            line-height: 1.5;
        }

        /* 消息分类标签 */
        .msg-tabs {
            display: flex;
            gap: 8px;
            margin-bottom: 15px;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .msg-tab {
            background: rgba(19, 32, 22, 0.7);
            border: 1px solid rgba(180, 145, 70, 0.25);
            color: var(--text-secondary);
            padding: 7px 16px;
            border-radius: 20px;
            font-size: 12px;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.2s;
        }

        .msg-tab.active {
            background: rgba(180, 145, 70, 0.15);
            border-color: var(--gold-glow);
            color: var(--gold-glow);
        }

        .msg-tab .badge {
            background: #ff4757;
            color: white;
            padding: 1px 6px;
            border-radius: 10px;
            font-size: 10px;
            margin-left: 4px;
        }

        /* 消息列表 */
        .message-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .message-item {
            background: rgba(19, 32, 22, 0.8);
            border: 1px solid rgba(180, 145, 70, 0.2);
            border-radius: 14px;
            padding: 14px;
            backdrop-filter: blur(8px);
            transition: all 0.2s;
            cursor: pointer;
            position: relative;
        }

        .message-item:hover {
            border-color: rgba(220, 187, 92, 0.5);
            box-shadow: 0 4px 15px rgba(180, 145, 70, 0.1);
        }

        .message-item.unread {
            border-left: 3px solid var(--gold-glow);
            background: rgba(19, 32, 22, 0.95);
        }

        .message-item .msg-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 6px;
        }

        .message-item .msg-type-icon {
            font-size: 20px;
            margin-right: 10px;
        }

        .message-item .msg-title {
            color: white;
            font-weight: 600;
            font-size: 14px;
            flex: 1;
        }

        .message-item .msg-time {
            color: rgba(255,255,255,0.4);
            font-size: 11px;
            white-space: nowrap;
        }

        .message-item .msg-content {
            color: var(--text-secondary);
            font-size: 12px;
            line-height: 1.5;
            margin-left: 30px;
        }

        .message-item .unread-dot {
            position: absolute;
            top: 16px;
            right: 14px;
            width: 8px;
            height: 8px;
            background: #ff4757;
            border-radius: 50%;
        }

        .message-item .msg-tag {
            display: inline-block;
            background: rgba(180, 145, 70, 0.15);
            color: var(--gold-glow);
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 10px;
            margin-top: 6px;
            margin-left: 30px;
        }

        .message-item .msg-tag.system {
            background: rgba(66, 133, 244, 0.2);
            color: #6db3ff;
        }

        .message-item .msg-tag.transaction {
            background: rgba(76, 175, 80, 0.2);
            color: #81c784;
        }

        .message-item .msg-tag.event {
            background: rgba(255, 152, 0, 0.2);
            color: #ffb74d;
        }

        /* 系统通知样式 */
        .system-notice {
            background: rgba(66, 133, 244, 0.08);
            border: 1px solid rgba(66, 133, 244, 0.2);
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .system-notice .notice-icon {
            font-size: 24px;
        }

        .system-notice .notice-info {
            flex: 1;
        }

        .system-notice .notice-title {
            color: white;
            font-weight: 600;
            font-size: 13px;
        }

        .system-notice .notice-desc {
            color: #8ab4f8;
            font-size: 11px;
        }

        .loading-spinner {
            display: inline-block;
            width: 14px;
            height: 14px;
            border: 2px solid rgba(180, 145, 70, 0.2);
            border-top: 2px solid var(--gold-glow);
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
            margin-right: 4px;
            vertical-align: middle;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* 底部导航 */
        .bottom-nav {
            flex-shrink: 0;
            background: rgba(10, 20, 13, 0.9);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(180, 145, 70, 0.2);
            border-radius: 20px;
            box-shadow: 0 -4px 30px rgba(0, 0, 0, 0.8);
            display: flex;
            justify-content: space-around;
            padding: 12px 0;
            margin: 0 15px 15px 15px;
            position: relative;
            z-index: 10;
        }

        .bottom-nav::before {
            content: '';
            position: absolute;
            top: -1px;
            left: -1px;
            right: -1px;
            bottom: -1px;
            border-radius: 20px;
            padding: 1px;
            background: linear-gradient(135deg, var(--gold-deep), transparent, var(--gold-light));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
            opacity: 0.5;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: var(--text-secondary);
            font-size: 11px;
            gap: 4px;
            cursor: pointer;
            padding: 5px 10px;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .nav-item .nav-icon {
            font-size: 18px;
        }

        .nav-item.active {
            color: var(--gold-light);
            position: relative;
        }

        .nav-item.active::after {
            content: '';
            position: absolute;
            top: -6px;
            left: 50%;
            transform: translateX(-50%);
            width: 20px;
            height: 2px;
            background: linear-gradient(to right, var(--gold-deep), var(--gold-glow));
            border-radius: 5px;
            box-shadow: 0 0 15px var(--gold-glow);
        }

        .nav-item:not(.active):hover {
            color: var(--gold-glow);
        }
    </style>
</head>
<body>
    <div class="app-container">
        <div class="scroll-area">
            <!-- 头部 -->
            <div class="header">
                <div class="logo-area">
                    <span class="logo-icon">💬</span>
                    <span>RARE ANIMAL</span>
                </div>
                <div class="header-controls">
                    <button class="lang-btn" id="langBtn">🇨🇳 CN ⌄</button>
                    <div class="lang-dropdown" id="langDropdown">
                        <div class="lang-option" data-lang="cn"><span>🇨🇳 简体中文</span><span class="code">CN</span></div>
                        <div class="lang-option" data-lang="en"><span>🇺🇸 English</span><span class="code">EN</span></div>
                        <div class="lang-option" data-lang="zh"><span>🇭🇰 繁體中文</span><span class="code">ZH</span></div>
                        <div class="lang-option" data-lang="es"><span>🇪🇸 Español</span><span class="code">ES</span></div>
                        <div class="lang-option" data-lang="fr"><span>🇫🇷 Français</span><span class="code">FR</span></div>
                        <div class="lang-option" data-lang="ko"><span>🇰🇷 한국어</span><span class="code">KO</span></div>
                        <div class="lang-option" data-lang="ja"><span>🇯🇵 日本語</span><span class="code">JA</span></div>
                        <div class="lang-option" data-lang="ar"><span>🇸🇦 العربية</span><span class="code">AR</span></div>
                        <div class="lang-option" data-lang="ru"><span>🇷🇺 Русский</span><span class="code">RU</span></div>
                    </div>
                    <button id="connectWalletBtn" class="connect-btn">Connect wallet</button>
                </div>
            </div>

            <!-- 页面标题 -->
            <div class="page-title">
                <h2>📬 讯息中心</h2>
                <p>系统通知 · 交易动态 · 活动提醒</p>
            </div>

            <!-- 消息分类标签 -->
            <div class="msg-tabs">
                <span class="msg-tab active msg-all" onclick="filterMessages('all', this)">全部</span>
                <span class="msg-tab msg-system" onclick="filterMessages('system', this)">系统<span class="badge">2</span></span>
                <span class="msg-tab msg-transaction" onclick="filterMessages('transaction', this)">交易<span class="badge">1</span></span>
                <span class="msg-tab msg-event" onclick="filterMessages('event', this)">活动</span>
            </div>

            <!-- 系统通知 -->
            <div class="system-notice" data-type="system">
                <div class="notice-icon">🔔</div>
                <div class="notice-info">
                    <div class="notice-title">系统维护公告</div>
                    <div class="notice-desc">平台将于7月28日进行升级维护</div>
                </div>
                <span style="color:rgba(255,255,255,0.3);font-size:10px;">2h前</span>
            </div>

            <!-- 消息列表 -->
            <div class="message-list">
                <!-- 交易消息 -->
                <div class="message-item unread" data-type="transaction" onclick="openMessage('交易成功', '你的至尊礼盒Mint成功！获得【大熊猫】传说卡牌 #0007')">
                    <div class="unread-dot"></div>
                    <div class="msg-header">
                        <span class="msg-type-icon">✅</span>
                        <span class="msg-title">交易成功</span>
                        <span class="msg-time">10分钟前</span>
                    </div>
                    <div class="msg-content">至尊礼盒Mint成功！恭喜获得稀有卡牌</div>
                    <span class="msg-tag transaction">交易确认</span>
                </div>

                <!-- 系统消息 -->
                <div class="message-item unread" data-type="system" onclick="openMessage('盲盒上新', '全新「极危珍稀」系列盲盒已上线！限时优惠进行中...')">
                    <div class="unread-dot"></div>
                    <div class="msg-header">
                        <span class="msg-type-icon">🎉</span>
                        <span class="msg-title">盲盒上新通知</span>
                        <span class="msg-time">1小时前</span>
                    </div>
                    <div class="msg-content">「极危珍稀」系列盲盒已上线！限时优惠</div>
                    <span class="msg-tag system">系统通知</span>
                </div>

                <!-- 活动消息 -->
                <div class="message-item" data-type="event" onclick="openMessage('限时活动', '参与「珍稀动物守护者」活动，赢取限量隐藏款卡牌！')">
                    <div class="msg-header">
                        <span class="msg-type-icon">🏆</span>
                        <span class="msg-title">限时活动开启</span>
                        <span class="msg-time">3小时前</span>
                    </div>
                    <div class="msg-content">「珍稀动物守护者」活动开启，赢隐藏款</div>
                    <span class="msg-tag event">活动提醒</span>
                </div>

                <!-- 交易消息 -->
                <div class="message-item" data-type="transaction" onclick="openMessage('收到卡牌', '用户 0x1234...5678 向你转赠了【金雕】稀有卡牌 #2210')">
                    <div class="msg-header">
                        <span class="msg-type-icon">📥</span>
                        <span class="msg-title">收到转赠卡牌</span>
                        <span class="msg-time">昨天</span>
                    </div>
                    <div class="msg-content">收到来自 0x1234...5678 的转赠</div>
                    <span class="msg-tag transaction">交易记录</span>
                </div>

                <!-- 系统消息 -->
                <div class="message-item" data-type="system" onclick="openMessage('合约升级', '智能合约已升级至V2版本，新增批量Mint功能')">
                    <div class="msg-header">
                        <span class="msg-type-icon">⚙️</span>
                        <span class="msg-title">合约升级完成</span>
                        <span class="msg-time">2天前</span>
                    </div>
                    <div class="msg-content">合约V2上线，新增批量Mint功能</div>
                    <span class="msg-tag system">系统通知</span>
                </div>

                <!-- 活动消息 -->
                <div class="message-item" data-type="event" onclick="openMessage('排行榜更新', '本周收藏排行榜已更新！查看你的排名')">
                    <div class="msg-header">
                        <span class="msg-type-icon">📊</span>
                        <span class="msg-title">排行榜更新</span>
                        <span class="msg-time">3天前</span>
                    </div>
                    <div class="msg-content">本周收藏排行已更新，快来看看排名</div>
                    <span class="msg-tag event">活动提醒</span>
                </div>
            </div>
        </div>

        <!-- 消息详情弹窗 -->
        <div class="modal-overlay" id="modalOverlay" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.9);z-index:100;justify-content:center;align-items:center;">
            <div style="background:linear-gradient(145deg, #1a2e1f, #0d1a14);border:2px solid var(--gold-glow);border-radius:20px;padding:25px;text-align:center;max-width:320px;width:90%;box-shadow:0 0 60px rgba(180,145,70,0.5);">
                <div style="font-size:50px;margin-bottom:15px;" id="modalIcon">📬</div>
                <div style="color:var(--gold-light);font-size:20px;font-weight:700;margin-bottom:10px;" id="modalTitle"></div>
                <div style="color:var(--text-secondary);font-size:13px;line-height:1.6;margin-bottom:20px;" id="modalContent"></div>
                <button onclick="closeModal()" style="padding:10px 30px;background:linear-gradient(180deg, #e7c778 0%, #b48b3a 100%);color:#0a130e;border:none;border-radius:25px;font-weight:700;cursor:pointer;font-size:14px;">确 定</button>
            </div>
        </div>

        <!-- 底部导航 -->
        <div class="bottom-nav">
            <a href="index.html" class="nav-item">
                <i class="fas fa-gem nav-icon"></i>
                <span class="nav-nft">挑选NFT</span>
            </a>
            <a href="entertainment.html" class="nav-item">
                <i class="fas fa-gamepad nav-icon"></i>
                <span class="nav-entertainment">娱乐</span>
            </a>
            <a href="market.html" class="nav-item">
                <i class="fas fa-store nav-icon"></i>
                <span class="nav-market">市场</span>
            </a>
            <a href="favorite.html" class="nav-item">
                <i class="fas fa-heart nav-icon"></i>
                <span class="nav-collection">收藏</span>
            </a>
            <a href="messages.html" class="nav-item active">
                <i class="fas fa-comments nav-icon"></i>
                <span class="nav-messages">讯息</span>
            </a>
        </div>
    </div>

    <script>
        // ======================== 多语言翻译数据 ========================
        const translations = {
            cn: {
                langBtn: '🇨🇳 CN',
                navNFT: '挑选NFT',
                navEntertainment: '娱乐',
                navMarket: '市场',
                navCollection: '收藏',
                navMessages: '讯息',
                msgAll: '全部',
                msgSystem: '系统',
                msgTransaction: '交易',
                msgEvent: '活动'
            },
            en: {
                langBtn: '🇺🇸 EN',
                navNFT: 'Pick NFT',
                navEntertainment: 'Entertain',
                navMarket: 'Market',
                navCollection: 'Favorite',
                navMessages: 'Messages',
                msgAll: 'All',
                msgSystem: 'System',
                msgTransaction: 'Trading',
                msgEvent: 'Events'
            },
            zh: {
                langBtn: '🇭🇰 繁中',
                navNFT: '挑選NFT',
                navEntertainment: '娛樂',
                navMarket: '市場',
                navCollection: '收藏',
                navMessages: '訊息',
                msgAll: '全部',
                msgSystem: '系統',
                msgTransaction: '交易',
                msgEvent: '活動'
            }
        };

        // ======================== 语言切换逻辑 ========================
        const langBtn = document.getElementById('langBtn');
        const langDropdown = document.getElementById('langDropdown');
        let currentLang = localStorage.getItem('bcbsLang') || 'cn';

        window.addEventListener('DOMContentLoaded', function() {
            const langData = translations[currentLang];
            if (langData) applyTranslations(langData);
        });

        langBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            langDropdown.classList.toggle('open');
            langBtn.classList.toggle('active');
        });

        document.addEventListener('click', (e) => {
            if (!langDropdown.contains(e.target) && e.target !== langBtn) {
                langDropdown.classList.remove('open');
                langBtn.classList.remove('active');
            }
        });

        document.querySelectorAll('.lang-option').forEach(option => {
            option.addEventListener('click', function() {
                const langCode = this.getAttribute('data-lang');
                const langData = translations[langCode];
                if (langData) {
                    currentLang = langCode;
                    localStorage.setItem('bcbsLang', langCode);
                    applyTranslations(langData);
                }
                langDropdown.classList.remove('open');
                langBtn.classList.remove('active');
            });
        });

        function applyTranslations(langData) {
            langBtn.textContent = langData.langBtn + ' ⌄';
            document.querySelector('.nav-nft').textContent = langData.navNFT;
            document.querySelector('.nav-entertainment').textContent = langData.navEntertainment;
            document.querySelector('.nav-market').textContent = langData.navMarket;
            document.querySelector('.nav-collection').textContent = langData.navCollection;
            document.querySelector('.nav-messages').textContent = langData.navMessages;
            document.querySelector('.msg-all').childNodes[0].textContent = langData.msgAll;
            document.querySelector('.msg-system').childNodes[0].textContent = langData.msgSystem;
            document.querySelector('.msg-transaction').childNodes[0].textContent = langData.msgTransaction;
            document.querySelector('.msg-event').childNodes[0].textContent = langData.msgEvent;
        }

        // ======================== 钱包连接 ========================
        const connectBtn = document.getElementById('connectWalletBtn');
        let currentAccount = null;
        let isLoading = false;

        connectBtn.addEventListener('click', async function() {
            if (isLoading) return;
            if (currentAccount) {
                disconnectWallet();
                return;
            }
            await connectWallet();
        });

        async function connectWallet() {
            if (!window.ethereum) {
                alert('请安装 MetaMask');
                return;
            }
            isLoading = true;
            connectBtn.disabled = true;
            connectBtn.innerHTML = '连接中<span class="loading-spinner"></span>';
            try {
                const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
                currentAccount = accounts[0];
                connectBtn.textContent = currentAccount.substring(0, 6) + '...' + currentAccount.substring(currentAccount.length - 4);
                connectBtn.classList.add('connected');
                connectBtn.disabled = false;
            } catch (e) {
                connectBtn.disabled = false;
                connectBtn.innerHTML = 'Connect wallet';
            }
        }

        function disconnectWallet() {
            currentAccount = null;
            connectBtn.textContent = 'Connect wallet';
            connectBtn.classList.remove('connected');
            connectBtn.disabled = false;
        }

        // ======================== 消息筛选 ========================
        function filterMessages(type, btn) {
            document.querySelectorAll('.msg-tab').forEach(t => t.classList.remove('active'));
            btn.classList.add('active');
            document.querySelectorAll('.message-item, .system-notice').forEach(item => {
                if (type === 'all' || item.getAttribute('data-type') === type) {
                    item.style.display = '';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // ======================== 消息详情弹窗 ========================
        function openMessage(title, content) {
            document.getElementById('modalTitle').textContent = title;
            document.getElementById('modalContent').textContent = content;
            document.getElementById('modalOverlay').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('modalOverlay').style.display = 'none';
        }

        document.getElementById('modalOverlay').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });
    </script>
</body>
</html>
