    <script>
        // ======================== 多语言翻译数据 ========================
        const translations = {
            cn: {
                langBtn: '🇨🇳 CN',
                navNFT: '挑选NFT',
                navEntertainment: '娱乐',
                navMarket: '市场',
                navCollection: '收藏',
                navEcosystem: '生态',
                filterAll: '全部',
                filterCommon: '普通',
                filterRare: '稀有',
                filterEpic: '史诗',
                filterLegendary: '传说',
                filterHidden: '隐藏款',
                btnMarket: '查看市场',
                statTotalSpecies: '总物种',
                statTotalCards: '总卡牌',
                statFloorPrice: '地板价 BNB',
                searchPlaceholder: '搜索动物名称...',
                modalBuy: '购 买',
                modalClose: '关 闭'
            },
            en: {
                langBtn: '🇺🇸 EN',
                navNFT: 'Pick NFT',
                navEntertainment: 'Entertain',
                navMarket: 'Market',
                navCollection: 'Favorite',
                navEcosystem: 'Ecosystem',
                filterAll: 'All',
                filterCommon: 'Common',
                filterRare: 'Rare',
                filterEpic: 'Epic',
                filterLegendary: 'Legendary',
                filterHidden: 'Hidden',
                btnMarket: 'View Market',
                statTotalSpecies: 'Species',
                statTotalCards: 'Cards',
                statFloorPrice: 'Floor BNB',
                searchPlaceholder: 'Search animal...',
                modalBuy: 'Buy',
                modalClose: 'Close'
            },
            zh: {
                langBtn: '🇭🇰 繁中',
                navNFT: '挑選NFT',
                navEntertainment: '娛樂',
                navMarket: '市場',
                navCollection: '收藏',
                navEcosystem: '生態',
                filterAll: '全部',
                filterCommon: '普通',
                filterRare: '稀有',
                filterEpic: '史詩',
                filterLegendary: '傳說',
                filterHidden: '隱藏款',
                btnMarket: '查看市場',
                statTotalSpecies: '總物種',
                statTotalCards: '總卡牌',
                statFloorPrice: '地板價 BNB',
                searchPlaceholder: '搜索動物名稱...',
                modalBuy: '購 買',
                modalClose: '關 閉'
            }
        };

        // ======================== 语言切换逻辑 ========================
        const langBtn = document.getElementById('langBtn');
        const langDropdown = document.getElementById('langDropdown');
        let currentLang = localStorage.getItem('bcbsLang') || 'cn';

        window.addEventListener('DOMContentLoaded', function() {
            const langData = translations[currentLang];
            if (langData) applyTranslations(langData);
        });

        langBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            langDropdown.classList.toggle('open');
            langBtn.classList.toggle('active');
        });

        document.addEventListener('click', (e) => {
            if (!langDropdown.contains(e.target) && e.target !== langBtn) {
                langDropdown.classList.remove('open');
                langBtn.classList.remove('active');
            }
        });

        document.querySelectorAll('.lang-option').forEach(option => {
            option.addEventListener('click', function() {
                const langCode = this.getAttribute('data-lang');
                const langData = translations[langCode];
                if (langData) {
                    currentLang = langCode;
                    localStorage.setItem('bcbsLang', langCode);
                    applyTranslations(langData);
                }
                langDropdown.classList.remove('open');
                langBtn.classList.remove('active');
            });
        });

        function applyTranslations(langData) {
            langBtn.textContent = langData.langBtn + ' ⌄';
            document.querySelector('.nav-nft').textContent = langData.navNFT;
            document.querySelector('.nav-entertainment').textContent = langData.navEntertainment;
            document.querySelector('.nav-market').textContent = langData.navMarket;
            document.querySelector('.nav-collection').textContent = langData.navCollection;
            document.querySelector('.nav-ecosystem').textContent = langData.navEcosystem;
            document.querySelector('.filter-all').textContent = langData.filterAll;
            document.querySelector('.filter-common').textContent = langData.filterCommon;
            document.querySelector('.filter-rare').textContent = langData.filterRare;
            document.querySelector('.filter-epic').textContent = langData.filterEpic;
            document.querySelector('.filter-legendary').textContent = langData.filterLegendary;
            document.querySelector('.filter-hidden').textContent = langData.filterHidden;
            document.querySelectorAll('.btn-market-text').forEach(btn => {
                btn.textContent = langData.btnMarket;
            });
            document.querySelector('.stat-total-species').textContent = langData.statTotalSpecies;
            document.querySelector('.stat-total-cards').textContent = langData.statTotalCards;
            document.querySelector('.stat-floor-price').textContent = langData.statFloorPrice;
            document.getElementById('searchInput').placeholder = langData.searchPlaceholder;
        }

        // ======================== 钱包连接 ========================
        const connectBtn = document.getElementById('connectWalletBtn');
        let currentAccount = null;
        let isLoading = false;

        connectBtn.addEventListener('click', async function() {
            if (isLoading) return;
            if (currentAccount) {
                disconnectWallet();
                return;
            }
            await connectWallet();
        });

        async function connectWallet() {
            if (!window.ethereum) {
                alert('请安装 MetaMask');
                return;
            }
            isLoading = true;
            connectBtn.disabled = true;
            connectBtn.innerHTML = '连接中<span class="loading-spinner"></span>';
            try {
                const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
                currentAccount = accounts[0];
                connectBtn.textContent = currentAccount.substring(0, 6) + '...' + currentAccount.substring(currentAccount.length - 4);
                connectBtn.classList.add('connected');
                connectBtn.disabled = false;
            } catch (e) {
                if (e.code === 4001) {
                    alert('请在 MetaMask 中授权连接');
                } else {
                    alert('连接失败: ' + (e.message || '未知错误'));
                }
                connectBtn.disabled = false;
                connectBtn.innerHTML = 'Connect wallet';
            } finally {
                isLoading = false;
            }
        }

        function disconnectWallet() {
            currentAccount = null;
            connectBtn.textContent = 'Connect wallet';
            connectBtn.classList.remove('connected');
            connectBtn.disabled = false;
        }

        async function autoConnect() {
            if (!window.ethereum) return;
            try {
                const accounts = await window.ethereum.request({ method: 'eth_accounts' });
                if (accounts && accounts.length > 0) {
                    currentAccount = accounts[0];
                    connectBtn.textContent = currentAccount.substring(0, 6) + '...' + currentAccount.substring(currentAccount.length - 4);
                    connectBtn.classList.add('connected');
                    connectBtn.disabled = false;
                }
            } catch (e) {}
        }
        setTimeout(() => autoConnect(), 500);

        // ======================== 筛选功能 ========================
        let currentFilter = 'all';

        function filterByRarity(rarity, btn) {
            currentFilter = rarity;
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            filterCards();
        }

        function filterCards() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const cards = document.querySelectorAll('.market-card');
            
            cards.forEach(card => {
                const rarity = card.getAttribute('data-rarity');
                const name = card.getAttribute('data-name').toLowerCase();
                
                const matchesRarity = currentFilter === 'all' || rarity === currentFilter;
                const matchesSearch = name.includes(searchTerm);
                
                if (matchesRarity && matchesSearch) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // ======================== 详情弹窗 ========================
        let currentDetail = {};

        function showDetail(icon, name, rarity, supply, price, number) {
            currentDetail = { icon, name, rarity, supply, price, number };
            document.getElementById('detailIcon').textContent = icon;
            document.getElementById('detailName').textContent = name;
            document.getElementById('detailRarity').textContent = rarity;
            document.getElementById('detailSupply').textContent = '总供应量：' + supply;
            document.getElementById('detailNumber').textContent = '编号：' + number;
            document.getElementById('detailPrice').textContent = price;
            document.getElementById('modalOverlay').classList.add('open');
        }

        function closeModal() {
            document.getElementById('modalOverlay').classList.remove('open');
        }

        document.getElementById('modalOverlay').addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });

        function handlePurchase() {
            if (!currentAccount) {
                alert('请先连接钱包');
                return;
            }
            alert('🛒 正在购买 ' + currentDetail.name + '...\n价格：' + currentDetail.price + '\n(演示模式)');
            closeModal();
        }

        function handleBuy(name) {
            if (!currentAccount) {
                alert('请先连接钱包');
                return;
            }
            alert('📊 跳转至' + name + '交易市场 (演示界面)');
        }
    </script>
