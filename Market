<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>市场 · 动物图鉴</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/5.7.2/ethers.umd.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        :root {
            --bg-color: #0d1a14;
            --card-bg: rgba(19, 32, 22, 0.85);
            --border-color: rgba(180, 145, 70, 0.25);
            --text-primary: #FFFFFF;
            --text-primary-soft: #f0e6d2;
            --text-secondary: #b8a47b;
            --gold-light: #f8ecc9;
            --gold-main: #d6b878;
            --gold-deep: #9e7a3a;
            --gold-glow: #dbb45c;
        }

        body {
            background-color: var(--bg-color);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            height: 100dvh;
            overflow: hidden;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            color: var(--text-primary);
            background-image: 
                radial-gradient(circle at 20% 10%, rgba(180, 145, 70, 0.12) 0%, transparent 35%),
                radial-gradient(circle at 80% 80%, rgba(220, 195, 140, 0.08) 0%, transparent 40%);
        }

        .app-container {
            width: 100%;
            max-width: 420px;
            height: 100%;
            max-height: 100vh;
            max-height: 100dvh;
            background: radial-gradient(circle at 50% 10%, #1a2e1f 0%, #0d1a14 100%);
            border-radius: 20px;
            box-shadow: 0 0 40px rgba(180, 145, 70, 0.15);
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
        }

        .app-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: radial-gradient(rgba(180, 145, 70, 0.06) 1px, transparent 1px);
            background-size: 40px 40px;
            opacity: 0.5;
            z-index: 0;
            pointer-events: none;
            border-radius: 20px;
        }

        .scroll-area {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
            -webkit-overflow-scrolling: touch;
            overscroll-behavior: contain;
            position: relative;
            z-index: 1;
        }

        /* 头部样式 */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 15px;
            position: relative;
        }

        .logo-area {
            display: flex;
            align-items: center;
            font-size: 18px;
            font-weight: 700;
            color: var(--gold-main);
            letter-spacing: 0.5px;
            text-shadow: 0 0 15px rgba(180, 145, 70, 0.4);
        }

        .logo-area .logo-icon {
            font-size: 28px;
            margin-right: 8px;
        }

        .header-controls {
            display: flex;
            gap: 8px;
            align-items: center;
            position: relative;
        }

        .lang-btn {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .lang-btn.active {
            background: rgba(180, 145, 70, 0.1);
            border-color: var(--gold-main);
            color: var(--gold-glow);
        }

        .lang-dropdown {
            display: none;
            position: absolute;
            top: 38px;
            right: 0;
            background: rgba(13, 26, 20, 0.97);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 12px;
            width: 200px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.8);
            z-index: 999;
            flex-direction: column;
            gap: 6px;
            max-height: 300px;
            overflow-y: auto;
        }

        .lang-dropdown.open {
            display: flex;
        }

        .lang-option {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            border-radius: 6px;
            color: var(--text-primary-soft);
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .lang-option:hover {
            background: rgba(197, 164, 85, 0.15);
            color: var(--gold-light);
        }

        .lang-option .code {
            color: var(--text-secondary);
            font-size: 12px;
            font-weight: 500;
            margin-left: 8px;
        }

        .connect-btn {
            background: transparent;
            border: 1px solid rgba(214, 184, 120, 0.4);
            color: var(--gold-glow);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            box-shadow: 0 0 15px rgba(180, 145, 70, 0.08);
            transition: all 0.3s;
            white-space: nowrap;
        }

        .connect-btn:hover:not(:disabled) {
            box-shadow: 0 0 25px rgba(180, 145, 70, 0.25);
            background: rgba(180, 145, 70, 0.08);
        }

        .connect-btn.connected {
            background: rgba(180, 145, 70, 0.12);
            border-color: var(--gold-glow);
            color: var(--gold-light);
        }

        .connect-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* 页面标题 */
        .page-title {
            text-align: center;
            margin-bottom: 20px;
        }

        .page-title h2 {
            font-size: 26px;
            font-weight: 700;
            background: linear-gradient(180deg, #f5e3b3 0%, #c5a455 60%, #8a6327 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 0 20px rgba(180, 145, 70, 0.5);
            margin-bottom: 6px;
        }

        .page-title p {
            color: #b8a16a;
            font-size: 13px;
            line-height: 1.5;
        }

        /* 筛选器 */
        .filter-bar {
            display: flex;
            gap: 8px;
            margin-bottom: 15px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: rgba(19, 32, 22, 0.8);
            border: 1px solid rgba(180, 145, 70, 0.3);
            color: var(--gold-glow);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }

        .filter-btn:hover {
            background: rgba(180, 145, 70, 0.15);
            border-color: var(--gold-glow);
        }

        .filter-btn.active {
            background: rgba(180, 145, 70, 0.2);
            border-color: var(--gold-glow);
            box-shadow: 0 0 12px rgba(180, 145, 70, 0.2);
        }

        /* 搜索框 */
        .search-box {
            position: relative;
            margin-bottom: 15px;
        }

        .search-box input {
            width: 100%;
            padding: 10px 40px 10px 14px;
            background: rgba(19, 32, 22, 0.8);
            border: 1px solid rgba(180, 145, 70, 0.3);
            border-radius: 12px;
            color: white;
            font-size: 13px;
            outline: none;
            transition: all 0.2s;
        }

        .search-box input::placeholder {
            color: rgba(255,255,255,0.4);
        }

        .search-box input:focus {
            border-color: var(--gold-glow);
            box-shadow: 0 0 15px rgba(180, 145, 70, 0.15);
        }

        .search-box .search-icon {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gold-glow);
            font-size: 14px;
        }

        /* 图鉴卡片网格 */
        .market-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .market-card {
            background: rgba(19, 32, 22, 0.8);
            border: 1px solid rgba(180, 145, 70, 0.25);
            border-radius: 14px;
            overflow: hidden;
            backdrop-filter: blur(8px);
            transition: all 0.3s;
            cursor: pointer;
        }

        .market-card:hover {
            border-color: rgba(220, 187, 92, 0.6);
            box-shadow: 0 6px 20px rgba(180, 145, 70, 0.2);
            transform: translateY(-3px);
        }

        .market-card .img-frame {
            width: 100%;
            height: 110px;
            background: linear-gradient(145deg, #1f2e22 0%, #0e1d13 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 55px;
            position: relative;
            overflow: hidden;
        }

        .market-card .img-frame .shimmer {
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.04), transparent);
            animation: shimmer 4s infinite;
        }

        @keyframes shimmer {
            0% { left: -100%; }
            100% { left: 100%; }
        }

        .market-card .rarity-badge {
            position: absolute;
            top: 8px;
            left: 8px;
            padding: 3px 8px;
            border-radius: 10px;
            font-size: 10px;
            font-weight: 600;
            z-index: 1;
        }

        .rarity-common {
            background: rgba(150, 150, 150, 0.3);
            color: #ccc;
        }

        .rarity-rare {
            background: rgba(66, 133, 244, 0.3);
            color: #6db3ff;
        }

        .rarity-epic {
            background: rgba(180, 70, 200, 0.3);
            color: #d98eff;
        }

        .rarity-legendary {
            background: rgba(255, 170, 40, 0.3);
            color: #ffb84d;
        }

        .rarity-hidden {
            background: rgba(255, 50, 80, 0.3);
            color: #ff6b81;
        }

        .market-card .info {
            padding: 10px;
        }

        .market-card .name {
            color: white;
            font-weight: 600;
            font-size: 13px;
            margin-bottom: 4px;
        }

        .market-card .supply-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .market-card .supply {
            color: var(--gold-glow);
            font-size: 10px;
        }

        .market-card .price-tag {
            color: var(--gold-light);
            font-size: 12px;
            font-weight: 600;
        }

        .btn-sm {
            width: 100%;
            padding: 7px;
            border: 1px solid rgba(180, 145, 70, 0.5);
            background: transparent;
            color: var(--gold-glow);
            border-radius: 10px;
            font-size: 11px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-sm:hover {
            background: rgba(180, 145, 70, 0.15);
            border-color: var(--gold-glow);
        }

        /* 详情弹窗 */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.9);
            z-index: 100;
            justify-content: center;
            align-items: center;
        }

        .modal-overlay.open {
            display: flex;
        }

        .modal-box {
            background: linear-gradient(145deg, #1a2e1f, #0d1a14);
            border: 2px solid var(--gold-glow);
            border-radius: 20px;
            padding: 25px;
            text-align: center;
            max-width: 320px;
            width: 90%;
            box-shadow: 0 0 60px rgba(180, 145, 70, 0.5);
        }

        .modal-box .detail-icon {
            font-size: 80px;
            animation: bounceIn 0.5s ease;
        }

        @keyframes bounceIn {
            0% { transform: scale(0); opacity: 0; }
            50% { transform: scale(1.2); }
            100% { transform: scale(1); opacity: 1; }
        }

        .modal-box .detail-name {
            color: var(--gold-light);
            font-size: 22px;
            font-weight: 700;
            margin: 15px 0 5px;
        }

        .modal-box .detail-rarity {
            font-size: 14px;
            margin-bottom: 10px;
        }

        .modal-box .detail-info {
            color: var(--text-secondary);
            font-size: 12px;
            margin-bottom: 4px;
        }

        .modal-box .detail-price {
            color: var(--gold-glow);
            font-size: 18px;
            font-weight: 700;
            margin: 10px 0;
        }

        .modal-box .btn-buy {
            padding: 10px 30px;
            background: linear-gradient(180deg, #e7c778 0%, #b48b3a 100%);
            color: #0a130e;
            border: none;
            border-radius: 25px;
            font-weight: 700;
            cursor: pointer;
            font-size: 14px;
            margin: 5px;
        }

        .modal-box .btn-close {
            padding: 8px 25px;
            background: transparent;
            border: 1px solid var(--gold-glow);
            color: var(--gold-glow);
            border-radius: 25px;
            cursor: pointer;
            font-size: 13px;
            margin: 5px;
        }

        .loading-spinner {
            display: inline-block;
            width: 14px;
            height: 14px;
            border: 2px solid rgba(180, 145, 70, 0.2);
            border-top: 2px solid var(--gold-glow);
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
            margin-right: 4px;
            vertical-align: middle;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* 底部导航 */
        .bottom-nav {
            flex-shrink: 0;
            background: rgba(10, 20, 13, 0.9);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(180, 145, 70, 0.2);
            border-radius: 20px;
            box-shadow: 0 -4px 30px rgba(0, 0, 0, 0.8);
            display: flex;
            justify-content: space-around;
            padding: 12px 0;
            margin: 0 15px 15px 15px;
            position: relative;
            z-index: 10;
        }

        .bottom-nav::before {
            content: '';
            position: absolute;
            top: -1px;
            left: -1px;
            right: -1px;
            bottom: -1px;
            border-radius: 20px;
            padding: 1px;
            background: linear-gradient(135deg, var(--gold-deep), transparent, var(--gold-light));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
            opacity: 0.5;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: var(--text-secondary);
            font-size: 11px;
            gap: 4px;
            cursor: pointer;
            padding: 5px 10px;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .nav-item .nav-icon {
            font-size: 18px;
        }

        .nav-item.active {
            color: var(--gold-light);
            position: relative;
        }

        .nav-item.active::after {
            content: '';
            position: absolute;
            top: -6px;
            left: 50%;
            transform: translateX(-50%);
            width: 20px;
            height: 2px;
            background: linear-gradient(to right, var(--gold-deep), var(--gold-glow));
            border-radius: 5px;
            box-shadow: 0 0 15px var(--gold-glow);
        }

        .nav-item:not(.active):hover {
            color: var(--gold-glow);
        }

        /* 统计条 */
        .stats-bar {
            display: flex;
            gap: 8px;
            margin-bottom: 15px;
        }

        .stat-item {
            flex: 1;
            background: rgba(19, 32, 22, 0.7);
            border: 1px solid rgba(180, 145, 70, 0.2);
            border-radius: 10px;
            padding: 10px;
            text-align: center;
        }

        .stat-item .stat-value {
            color: var(--gold-light);
            font-size: 18px;
            font-weight: 700;
        }

        .stat-item .stat-label {
            color: var(--text-secondary);
            font-size: 10px;
            margin-top: 2px;
        }
    </style>
</head>
<body>
    <div class="app-container">
        <div class="scroll-area">
            <!-- 头部 -->
            <div class="header">
                <div class="logo-area">
                    <span class="logo-icon">🏪</span>
                    <span>RARE ANIMAL</span>
                </div>
                <div class="header-controls">
                    <button class="lang-btn" id="langBtn">🇨🇳 CN ⌄</button>
                    <div class="lang-dropdown" id="langDropdown">
                        <div class="lang-option" data-lang="cn"><span>🇨🇳 简体中文</span><span class="code">CN</span></div>
                        <div class="lang-option" data-lang="en"><span>🇺🇸 English</span><span class="code">EN</span></div>
                        <div class="lang-option" data-lang="zh"><span>🇭🇰 繁體中文</span><span class="code">ZH</span></div>
                        <div class="lang-option" data-lang="es"><span>🇪🇸 Español</span><span class="code">ES</span></div>
                        <div class="lang-option" data-lang="fr"><span>🇫🇷 Français</span><span class="code">FR</span></div>
                        <div class="lang-option" data-lang="ko"><span>🇰🇷 한국어</span><span class="code">KO</span></div>
                        <div class="lang-option" data-lang="ja"><span>🇯🇵 日本語</span><span class="code">JA</span></div>
                        <div class="lang-option" data-lang="ar"><span>🇸🇦 العربية</span><span class="code">AR</span></div>
                        <div class="lang-option" data-lang="ru"><span>🇷🇺 Русский</span><span class="code">RU</span></div>
                    </div>
                    <button id="connectWalletBtn" class="connect-btn">Connect wallet</button>
                </div>
            </div>

            <!-- 页面标题 -->
            <div class="page-title">
                <h2>📖 动物图鉴市场</h2>
                <p>探索珍稀动物卡牌 · 收藏链上唯一珍品</p>
            </div>

            <!-- 统计数据 -->
            <div class="stats-bar">
                <div class="stat-item">
                    <div class="stat-value">12</div>
                    <div class="stat-label stat-total-species">总物种</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value">8,500</div>
                    <div class="stat-label stat-total-cards">总卡牌</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value">0.005</div>
                    <div class="stat-label stat-floor-price">地板价 BNB</div>
                </div>
            </div>

            <!-- 搜索框 -->
            <div class="search-box">
                <input type="text" id="searchInput" placeholder="搜索动物名称..." oninput="filterCards()">
                <i class="fas fa-search search-icon"></i>
            </div>

            <!-- 筛选器 -->
            <div class="filter-bar">
                <span class="filter-btn active filter-all" onclick="filterByRarity('all', this)">全部</span>
                <span class="filter-btn filter-common" onclick="filterByRarity('common', this)">普通</span>
                <span class="filter-btn filter-rare" onclick="filterByRarity('rare', this)">稀有</span>
                <span class="filter-btn filter-epic" onclick="filterByRarity('epic', this)">史诗</span>
                <span class="filter-btn filter-legendary" onclick="filterByRarity('legendary', this)">传说</span>
                <span class="filter-btn filter-hidden" onclick="filterByRarity('hidden', this)">隐藏款</span>
            </div>

            <!-- 图鉴卡片网格 -->
            <div class="market-grid" id="marketGrid">
                <!-- 传说 -->
                <div class="market-card" data-rarity="legendary" data-name="雪豹" onclick="showDetail('🐅', '雪豹', '传说', '100', '2.5 BNB', '#0001')">
                    <div class="img-frame">
                        <div class="shimmer"></div>
                        <span class="rarity-badge rarity-legendary">传说</span>
                        🐅
                    </div>
                    <div class="info">
                        <div class="name">雪豹</div>
                        <div class="supply-row">
                            <span class="supply">总量 100</span>
                            <span class="price-tag">2.5 BNB</span>
                        </div>
                        <button class="btn-sm btn-market-text" onclick="event.stopPropagation(); handleBuy('雪豹')">查看市场</button>
                    </div>
                </div>

                <!-- 传说 -->
                <div class="market-card" data-rarity="legendary" data-name="大熊猫" onclick="showDetail('🐼', '大熊猫', '传说', '100', '3.0 BNB', '#0007')">
                    <div class="img-frame">
                        <div class="shimmer"></div>
                        <span class="rarity-badge rarity-legendary">传说</span>
                        🐼
                    </div>
                    <div class="info">
                        <div class="name">大熊猫</div>
                        <div class="supply-row">
                            <span class="supply">总量 100</span>
                            <span class="price-tag">3.0 BNB</span>
                        </div>
                        <button class="btn-sm btn-market-text" onclick="event.stopPropagation(); handleBuy('大熊猫')">查看市场</button>
                    </div>
                </div>

                <!-- 史诗 -->
                <div class="market-card" data-rarity="epic" data-name="绿孔雀" onclick="showDetail('🦚', '绿孔雀', '史诗', '600', '0.5 BNB', '#0103')">
                    <div class="img-frame">
                        <div class="shimmer"></div>
                        <span class="rarity-badge rarity-epic">史诗</span>
                        🦚
                    </div>
                    <div class="info">
                        <div class="name">绿孔雀</div>
                        <div class="supply-row">
                            <span class="supply">总量 600</span>
                            <span class="price-tag">0.5 BNB</span>
                        </div>
                        <button class="btn-sm btn-market-text" onclick="event.stopPropagation(); handleBuy('绿孔雀')">查看市场</button>
                    </div>
                </div>

                <!-- 史诗 -->
                <div class="market-card" data-rarity="epic" data-name="白犀牛" onclick="showDetail('🦏', '白犀牛', '史诗', '600', '0.45 BNB', '#0892')">
                    <div class="img-frame">
                        <div class="shimmer"></div>
                        <span class="rarity-badge rarity-epic">史诗</span>
                        🦏
                    </div>
                    <div class="info">
                        <div class="name">白犀牛</div>
                        <div class="supply-row">
                            <span class="supply">总量 600</span>
                            <span class="price-tag">0.45 BNB</span>
                        </div>
