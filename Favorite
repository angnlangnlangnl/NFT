<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>收藏 · 我的藏品</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/5.7.2/ethers.umd.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; }
        :root { --bg:#0d1a14; --gold-light:#f8ecc9; --gold:#d6b878; --gold-deep:#9e7a3a; --gold-glow:#dbb45c; --text-secondary:#b8a47b; }
        body { 
            background-color: #0d1a14;
            display:flex; justify-content:center; align-items:center; 
            height:100vh; height:100dvh; overflow:hidden; 
            position:fixed; top:0; left:0; right:0; bottom:0; color:#fff; 
        }
        .app { 
            width:100%; max-width:420px; height:100%; 
            background: radial-gradient(circle at 50% 10%, #1a2e1f 0%, #0d1a14 100%); 
            border-radius:20px; box-shadow:0 0 40px rgba(180,145,70,0.15); 
            display:flex; flex-direction:column; position:relative; overflow:hidden; 
        }
        .app::before { 
            content:''; position:absolute; top:0; left:0; right:0; bottom:0; 
            background-image:radial-gradient(rgba(180,145,70,0.06) 1px, transparent 1px); 
            background-size:40px 40px; opacity:0.5; z-index:0; pointer-events:none; border-radius:20px; 
        }
        .scroll { flex:1; overflow-y:auto; padding:15px; -webkit-overflow-scrolling:touch; position:relative; z-index:1; }
        .header { display:flex; justify-content:space-between; align-items:center; padding-bottom:15px; flex-wrap:wrap; }
        .logo { display:flex; align-items:center; font-size:16px; font-weight:700; color:var(--gold); text-shadow:0 0 15px rgba(180,145,70,0.4); }
        .logo .icon { font-size:24px; margin-right:6px; }
        .header-right { display:flex; gap:6px; align-items:center; position:relative; flex-shrink:0; }
        .lang-btn { background:transparent; border:1px solid rgba(180,145,70,0.25); color:var(--text-secondary); padding:4px 8px; border-radius:6px; font-size:11px; cursor:pointer; white-space:nowrap; }
        .lang-dropdown { display:none; position:absolute; top:36px; right:0; background:rgba(13,26,20,0.97); backdrop-filter:blur(12px); border:1px solid rgba(180,145,70,0.25); border-radius:12px; padding:10px; width:160px; box-shadow:0 8px 32px rgba(0,0,0,0.8); z-index:999; flex-direction:column; gap:4px; }
        .lang-dropdown.open { display:flex; }
        .lang-option { display:flex; align-items:center; justify-content:space-between; padding:6px 10px; border-radius:6px; color:#f0e6d2; font-size:12px; cursor:pointer; }
        .lang-option:hover { background:rgba(197,164,85,0.15); color:var(--gold-light); }
        .lang-option .code { color:var(--text-secondary); font-size:10px; margin-left:6px; }
        .wallet-btn { background:transparent; border:1px solid rgba(214,184,120,0.4); color:var(--gold-glow); padding:5px 10px; border-radius:20px; font-size:11px; cursor:pointer; white-space:nowrap; }
        .wallet-btn.connected { background:rgba(180,145,70,0.12); border-color:var(--gold-glow); color:var(--gold-light); }
        .page { display:none; }
        .page.active { display:block; }
        .title { text-align:center; margin-bottom:20px; }
        .title h2 { font-size:26px; font-weight:700; background:linear-gradient(180deg, #f5e3b3 0%, #c5a455 60%, #8a6327 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; text-shadow:0 0 20px rgba(180,145,70,0.5); margin-bottom:6px; }
        .title p { color:#b8a16a; font-size:13px; }

        .stats { background:rgba(19,32,22,0.8); border:1px solid rgba(180,145,70,0.25); border-radius:14px; padding:15px; margin-bottom:15px; display:flex; justify-content:space-around; text-align:center; backdrop-filter:blur(8px); }
        .stat-item { flex:1; } .stat-item .val { color:var(--gold-light); font-size:22px; font-weight:700; } .stat-item .lbl { color:var(--text-secondary); font-size:11px; }
        .stat-div { width:1px; background:rgba(180,145,70,0.2); }

        .grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
        .nft-card { background:rgba(19,32,22,0.8); border:1px solid rgba(180,145,70,0.25); border-radius:14px; padding:12px; text-align:center; backdrop-filter:blur(8px); cursor:pointer; transition:all 0.3s; }
        .nft-card:hover { border-color:rgba(220,187,92,0.6); transform:translateY(-3px); }
        .nft-card .frame { 
            width:100%; height:90px; border-radius:10px; 
            background:linear-gradient(145deg, #1f2e22 0%, #0e1d13 100%); 
            border:1px solid rgba(212,175,85,0.3); 
            display:flex; align-items:center; justify-content:center; 
            font-size:45px; margin-bottom:8px; 
            overflow:hidden;
        }
        .nft-card .frame img {
            width:100%; height:100%; object-fit:cover;
        }
        .nft-card .name { color:white; font-size:13px; font-weight:600; }
        .nft-card .rarity { font-size:11px; }
        .r-legendary { color:#ffb84d; } .r-epic { color:#d98eff; } .r-rare { color:#6db3ff; } .r-common { color:#ccc; }

        /* ========== 弹窗样式 ========== */
        .modal-overlay { display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.9); z-index:1000; justify-content:center; align-items:center; }
        .modal-overlay.open { display:flex; }

        .modal-box { 
            position:relative;
            width:380px; 
            max-width:90vw;
            background: radial-gradient(circle at center, #13221e 0%, #09110d 100%); 
            border-radius:20px;
            border: 2px solid var(--gold-glow);
            box-shadow:0 20px 50px rgba(0,0,0,0.9), 0 0 60px rgba(180,145,70,0.4);
            padding:20px 15px 20px;
            display:flex;
            flex-direction:column;
            align-items:center;
            animation:modalIn 0.3s ease;
        }
        @keyframes modalIn { from { transform:scale(0.8); opacity:0; } to { transform:scale(1); opacity:1; } }

        .modal-box .modal-id-top {
            color: var(--text-secondary);
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 2px;
            margin-bottom: 10px;
            text-align: center;
        }

        .modal-box .modal-img-area {
            width:200px;
            height:200px;
            display:flex;
            align-items:center;
            justify-content:center;
            overflow:hidden;
            margin-bottom: 10px;
        }
        .modal-box .modal-img-area img {
            width:100%;
            height:100%;
            object-fit:contain;
        }
        .modal-box .modal-img-area .emoji-fallback {
            font-size:100px;
        }

        .modal-box .stamp-panel {
            width: 100%;
            background: rgba(20, 34, 28, 0.6);
            border: 1px solid rgba(168, 139, 68, 0.3);
            border-radius: 12px;
            padding: 18px 15px 10px;
            text-align: center;
            margin-bottom: 8px;
            position: relative;
            margin-top: 10px;
        }

        .modal-box .stamp-title {
            display: inline-block;
            background: linear-gradient(to bottom, #e6c971, #a88b44);
            color: #1a1a1a;
            font-size: 15px; 
            font-weight: bold;
            letter-spacing: 3px;
            padding: 4px 24px;
            border-radius: 4px;
            text-shadow: 0 1px 1px rgba(255,255,255,0.3);
            white-space: nowrap;
            position: absolute;
            top: -14px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 5;
        }
        .modal-box .stamp-title::before, 
        .modal-box .stamp-title::after {
            content: '●';
            display: inline-block;
            color: #1a1a1a;
            font-size: 5px;
            margin: 0 8px;
            vertical-align: middle;
            text-shadow: none;
        }

        .modal-box .stamp-grid {
            display: grid;
            grid-template-columns: 1fr 1fr; 
            grid-template-rows: auto auto;  
            gap: 6px 10px; 
            padding: 0 5px;
            margin-top: 4px;
        }
        .modal-box .stamp-row {
            display: flex;
            justify-content: center;
            align-items: baseline;
            font-size: 11px; 
        }
        .modal-box .stamp-label {
            color: #cbb780;
            margin-right: 4px;
            font-weight: 500;
            white-space: nowrap; 
        }
        .modal-box .stamp-value {
            color: #faf6e8;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .modal-box .modal-price-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 12px;
        }
        .modal-box .modal-price-display {
            color: var(--gold-glow);
            font-size: 20px;
            font-weight: 700;
        }
        .modal-box .modal-mint-days {
            color: rgba(255,255,255,0.5);
            font-size: 12px;
            font-weight: 500;
        }

        .modal-btns { 
            display:flex; 
            gap:10px; 
            width: 100%;
        }
        .btn-confirm { 
            flex:1; 
            padding:12px; 
            background:linear-gradient(180deg, #e7c778 0%, #b48b3a 100%); 
            color:#0a130e; 
            border:none; 
            border-radius:25px; 
            font-weight:700; 
            font-size:15px; 
            cursor:pointer; 
        }
        .btn-cancel { 
            flex:1; 
            padding:12px; 
            background:transparent; 
            border:1px solid var(--gold-glow); 
            color:var(--gold-glow); 
            border-radius:25px; 
            font-size:15px; 
            cursor:pointer; 
        }
        .btn-cancel:hover { background:rgba(180,145,70,0.1); }
        .btn-confirm:hover { background:linear-gradient(180deg, #f5da8a 0%, #c79d46 100%); }

        .bottom-nav { flex-shrink:0; background:rgba(10,20,13,0.9); backdrop-filter:blur(12px); border:1px solid rgba(180,145,70,0.2); border-radius:20px; box-shadow:0 -4px 30px rgba(0,0,0,0.8); display:flex; justify-content:space-around; padding:10px 0; margin:0 12px 12px 12px; position:relative; z-index:10; }
        .bottom-nav::before { content:''; position:absolute; top:-1px; left:-1px; right:-1px; bottom:-1px; border-radius:20px; padding:1px; background:linear-gradient(135deg, var(--gold-deep), transparent, var(--gold-light)); -webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); -webkit-mask-composite:xor; mask-composite:exclude; pointer-events:none; opacity:0.5; }
        .nav-item { display:flex; flex-direction:column; align-items:center; color:var(--text-secondary); font-size:10px; gap:3px; cursor:pointer; padding:4px 8px; transition:all 0.3s; text-decoration:none; }
        .nav-item .nav-icon { font-size:16px; }
        .nav-item.active { color:var(--gold-light); position:relative; }
        .nav-item.active::after { content:''; position:absolute; top:-5px; left:50%; transform:translateX(-50%); width:18px; height:2px; background:linear-gradient(to right, var(--gold-deep), var(--gold-glow)); border-radius:5px; box-shadow:0 0 15px var(--gold-glow); }
        .nav-item:not(.active):hover { color:var(--gold-glow); }
    </style>
</head>
<body>
    <div class="app">
        <div class="scroll">
            <div class="header">
                <div class="logo"><span class="icon" id="logoIcon">❤️</span><span>RARE</span></div>
                <div class="header-right">
                    <button class="lang-btn" id="langBtn">CN ⌄</button>
                    <div class="lang-dropdown" id="langDropdown">
                        <div class="lang-option" data-lang="cn"><span>🇨🇳 简体中文</span><span class="code">CN</span></div>
                        <div class="lang-option" data-lang="en"><span>🇺🇸 English</span><span class="code">EN</span></div>
                        <div class="lang-option" data-lang="zh"><span>🇭🇰 繁體中文</span><span class="code">ZH</span></div>
                    </div>
                    <button id="walletBtn" class="wallet-btn">Connect</button>
                </div>
            </div>

            <div class="page active" id="page-favorite">
                <div class="title"><h2>🗂️ 我的藏品</h2><p>你的珍稀动物收藏库 · 墨绿鎏金典藏</p></div>
                <div class="stats">
                    <div class="stat-item"><div class="val">8</div><div class="lbl">总藏品</div></div><div class="stat-div"></div>
                    <div class="stat-item"><div class="val">3</div><div class="lbl">稀有以上</div></div><div class="stat-div"></div>
                    <div class="stat-item"><div class="val">2</div><div class="lbl">传说</div></div><div class="stat-div"></div>
                    <div class="stat-item"><div class="val">4.8</div><div class="lbl">估值 BNB</div></div>
                </div>
                <div class="grid-2">
                    <div class="nft-card" onclick="showCardDetail(cardData[0])">
                        <div class="frame"><img src="images/background.png" alt="最贵邮票" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"></div>
                        <div class="name">最贵邮票</div><div class="rarity r-legendary">传世孤品</div>
                    </div>
                    <div class="nft-card" onclick="showCardDetail(cardData[1])"><div class="frame">🐼</div><div class="name">大熊猫</div><div class="rarity r-legendary">传说</div></div>
                    <div class="nft-card" onclick="showCardDetail(cardData[2])"><div class="frame">🦏</div><div class="name">白犀牛</div><div class="rarity r-epic">史诗</div></div>
                    <div class="nft-card" onclick="showCardDetail(cardData[3])"><div class="frame">🦅</div><div class="name">金雕</div><div class="rarity r-rare">稀有</div></div>
                    <div class="nft-card" onclick="showCardDetail(cardData[4])"><div class="frame">🐘</div><div class="name">亚洲象</div><div class="rarity r-rare">稀有</div></div>
                    <div class="nft-card" onclick="showCardDetail(cardData[5])"><div class="frame">🐯</div><div class="name">孟加拉虎</div><div class="rarity r-rare">稀有</div></div>
                    <div class="nft-card" onclick="showCardDetail(cardData[6])"><div class="frame">🦊</div><div class="name">藏狐</div><div class="rarity r-common">普通</div></div>
                    <div class="nft-card" onclick="showCardDetail(cardData[7])"><div class="frame">🦌</div><div class="name">麋鹿</div><div class="rarity r-common">普通</div></div>
                </div>
            </div>
        </div>

        <!-- 弹窗 -->
        <div class="modal-overlay" id="cardModal">
            <div class="modal-box">
                <div class="modal-id-top" id="modalIdTop">#0001</div>
                <div class="modal-img-area">
                    <img id="modalImg" src="" alt="" style="display:none;">
                    <span class="emoji-fallback" id="modalEmoji">🎁</span>
                </div>
                <div class="stamp-panel">
                    <div class="stamp-title" id="modalName">最贵邮票</div>
                    <div class="stamp-grid">
                        <div class="stamp-row"><span class="stamp-label">年份：</span><span class="stamp-value" id="modalYear">1840</span></div>
                        <div class="stamp-row"><span class="stamp-label">估值：</span><span class="stamp-value" id="modalEstimate">约850万美元</span></div>
                        <div class="stamp-row"><span class="stamp-label">稀有度：</span><span class="stamp-value" id="modalRarity">传世孤品</span></div>
                        <div class="stamp-row"><span class="stamp-label">来源：</span><span class="stamp-value" id="modalSource">英国邮政史</span></div>
                    </div>
                </div>
                <div class="modal-price-row">
                    <span class="modal-price-display" id="modalPrice">2.5 BNB</span>
                    <span class="modal-mint-days">铸造7天</span>
                </div>
                <div class="modal-btns">
                    <button class="btn-cancel" onclick="closeModal()">取 消</button>
                    <button class="btn-confirm" onclick="confirmCard()">兑 换</button>
                </div>
            </div>
        </div>

        <div class="bottom-nav">
            <a href="index.html" class="nav-item"><i class="fas fa-gem nav-icon"></i><span>NFT</span></a>
            <a href="entertainment.html" class="nav-item"><i class="fas fa-gamepad nav-icon"></i><span>娱乐</span></a>
            <a href="market.html" class="nav-item"><i class="fas fa-store nav-icon"></i><span>市场</span></a>
            <a href="favorite.html" class="nav-item active"><i class="fas fa-heart nav-icon"></i><span>收藏</span></a>
            <a href="ecosystem.html" class="nav-item"><i class="fas fa-globe nav-icon"></i><span>生态</span></a>
        </div>
    </div>

    <script>
        const cardData = [
            { icon:'🐅', name:'最贵邮票', rarity:'传世孤品', id:'#0001', year:'1840', estimate:'约850万美元', source:'英国邮政史', price:'2.5 BNB', color:'#ffb84d', img:'images/youpiao1.png' },
            { icon:'🐼', name:'大熊猫', rarity:'传说', id:'#0007', year:'远古', estimate:'无价', source:'中国四川', price:'3.0 BNB', color:'#ffb84d', img:'images/youpiao2.png' },
            { icon:'🦏', name:'白犀牛', rarity:'史诗', id:'#0892', year:'现代', estimate:'45万美元', source:'非洲草原', price:'0.45 BNB', color:'#d98eff', img:'images/youpiao3.png' },
            { icon:'🦅', name:'金雕', rarity:'稀有', id:'#2210', year:'现代', estimate:'8万美元', source:'北半球', price:'0.08 BNB', color:'#6db3ff', img:'images/youpiao4.png' },
            { icon:'🐘', name:'亚洲象', rarity:'稀有', id:'#1502', year:'现代', estimate:'7万美元', source:'东南亚', price:'0.07 BNB', color:'#6db3ff', img:'images/youpiao5.png' },
            { icon:'🐯', name:'孟加拉虎', rarity:'稀有', id:'#1024', year:'现代', estimate:'9万美元', source:'印度', price:'0.09 BNB', color:'#6db3ff', img:'images/youpiao7.png' },
            { icon:'🦊', name:'藏狐', rarity:'普通', id:'#2451', year:'现代', estimate:'1万美元', source:'青藏高原', price:'0.01 BNB', color:'#ccc', img:'images/youpiao6.png' },
            { icon:'🦚', name:'绿孔雀', rarity:'史诗', id:'#0103', year:'现代', estimate:'50万美元', source:'东南亚', price:'0.5 BNB', color:'#d98eff', img:'images/youpiao9.png' },
            { icon:'🐬', name:'中华白海豚', rarity:'稀有', id:'#3345', year:'现代', estimate:'10万美元', source:'中国南海', price:'0.1 BNB', color:'#6db3ff', img:'images/youpiao10.png' }
        ];

        function showCardDetail(card) {
            const modalImg = document.getElementById('modalImg');
            const modalEmoji = document.getElementById('modalEmoji');
            if (card.img) {
                modalImg.src = card.img;
                modalImg.style.display = 'block';
                modalEmoji.style.display = 'none';
            } else {
                modalImg.style.display = 'none';
                modalEmoji.style.display = 'block';
                modalEmoji.textContent = card.icon;
            }
            document.getElementById('modalIdTop').textContent = card.id;
            document.getElementById('modalName').textContent = card.name;
            document.getElementById('modalYear').textContent = card.year;
            document.getElementById('modalEstimate').textContent = card.estimate;
            document.getElementById('modalRarity').textContent = card.rarity;
            document.getElementById('modalRarity').style.color = card.color || '#ffb84d';
            document.getElementById('modalSource').textContent = card.source;
            document.getElementById('modalPrice').textContent = card.price;
            document.getElementById('cardModal').classList.add('open');
        }
        function closeModal() {
            document.getElementById('cardModal').classList.remove('open');
        }
        function confirmCard() {
            alert('✅ 兑换成功！');
            document.getElementById('cardModal').classList.remove('open');
        }
        document.getElementById('cardModal').addEventListener('click',function(e){ if(e.target===this)closeModal(); });

        const lb=document.getElementById('langBtn'),ld=document.getElementById('langDropdown');
        lb.addEventListener('click',e=>{e.stopPropagation();ld.classList.toggle('open');});
        document.addEventListener('click',e=>{if(!ld.contains(e.target)&&e.target!==lb)ld.classList.remove('open');});
        document.querySelectorAll('.lang-option').forEach(o=>o.addEventListener('click',function(){localStorage.setItem('bcbsLang',this.getAttribute('data-lang'));ld.classList.remove('open');}));
        const wb=document.getElementById('walletBtn'); let ac=null;
        wb.addEventListener('click',async function(){
            if(ac){ac=null;wb.textContent='Connect';wb.classList.remove('connected');return;}
            if(!window.ethereum){alert('请安装 MetaMask');return;} wb.innerHTML='...';
            try{const a=await window.ethereum.request({method:'eth_requestAccounts'});ac=a[0];wb.textContent=ac.substring(0,6)+'...'+ac.substring(ac.length-4);wb.classList.add('connected');}catch(e){wb.textContent='Connect';}
        });
        (async()=>{if(window.ethereum){try{const a=await window.ethereum.request({method:'eth_accounts'});if(a.length>0){ac=a[0];wb.textContent=ac.substring(0,6)+'...'+ac.substring(ac.length-4);wb.classList.add('connected');}}catch(e){}}})();
    </script>
</body>
</html>
