    <script>
        // ======================== 多语言翻译数据 ========================
        const translations = {
            cn: {
                langBtn: '🇨🇳 CN',
                navNFT: '挑选NFT',
                navEntertainment: '娱乐',
                navMarket: '市场',
                navCollection: '收藏',
                navEcosystem: '生态',
                statTotal: '总藏品',
                statRare: '稀有以上',
                statLegendary: '传说',
                statValue: '估值 BNB',
                collectionListTitle: '藏品列表',
                modalTransfer: '转 赠',
                modalSell: '出 售'
            },
            en: {
                langBtn: '🇺🇸 EN',
                navNFT: 'Pick NFT',
                navEntertainment: 'Entertain',
                navMarket: 'Market',
                navCollection: 'Favorite',
                navEcosystem: 'Ecosystem',
                statTotal: 'Total',
                statRare: 'Rare+',
                statLegendary: 'Legendary',
                statValue: 'Value BNB',
                collectionListTitle: 'Collection',
                modalTransfer: 'Transfer',
                modalSell: 'Sell'
            },
            zh: {
                langBtn: '🇭🇰 繁中',
                navNFT: '挑選NFT',
                navEntertainment: '娛樂',
                navMarket: '市場',
                navCollection: '收藏',
                navEcosystem: '生態',
                statTotal: '總藏品',
                statRare: '稀有以上',
                statLegendary: '傳說',
                statValue: '估值 BNB',
                collectionListTitle: '藏品列表',
                modalTransfer: '轉 贈',
                modalSell: '出 售'
            }
        };

        // ======================== 语言切换逻辑 ========================
        const langBtn = document.getElementById('langBtn');
        const langDropdown = document.getElementById('langDropdown');
        let currentLang = localStorage.getItem('bcbsLang') || 'cn';

        window.addEventListener('DOMContentLoaded', function() {
            const langData = translations[currentLang];
            if (langData) applyTranslations(langData);
        });

        langBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            langDropdown.classList.toggle('open');
            langBtn.classList.toggle('active');
        });

        document.addEventListener('click', (e) => {
            if (!langDropdown.contains(e.target) && e.target !== langBtn) {
                langDropdown.classList.remove('open');
                langBtn.classList.remove('active');
            }
        });

        document.querySelectorAll('.lang-option').forEach(option => {
            option.addEventListener('click', function() {
                const langCode = this.getAttribute('data-lang');
                const langData = translations[langCode];
                if (langData) {
                    currentLang = langCode;
                    localStorage.setItem('bcbsLang', langCode);
                    applyTranslations(langData);
                }
                langDropdown.classList.remove('open');
                langBtn.classList.remove('active');
            });
        });

        function applyTranslations(langData) {
            langBtn.textContent = langData.langBtn + ' ⌄';
            document.querySelector('.nav-nft').textContent = langData.navNFT;
            document.querySelector('.nav-entertainment').textContent = langData.navEntertainment;
            document.querySelector('.nav-market').textContent = langData.navMarket;
            document.querySelector('.nav-collection').textContent = langData.navCollection;
            document.querySelector('.nav-ecosystem').textContent = langData.navEcosystem;
            document.querySelector('.stat-total').textContent = langData.statTotal;
            document.querySelector('.stat-rare').textContent = langData.statRare;
            document.querySelector('.stat-legendary').textContent = langData.statLegendary;
            document.querySelector('.stat-value-label').textContent = langData.statValue;
            document.querySelector('.collection-list-title').textContent = langData.collectionListTitle;
        }

        // ======================== 视图切换 ========================
        function switchView(view, btn) {
            document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            if (view === 'grid') {
                document.getElementById('gridView').style.display = 'grid';
                document.getElementById('listView').style.display = 'none';
            } else {
                document.getElementById('gridView').style.display = 'none';
                document.getElementById('listView').style.display = 'flex';
            }
        }

        // ======================== 钱包连接 ========================
        const connectBtn = document.getElementById('connectWalletBtn');
        let currentAccount = null;
        let isLoading = false;

        connectBtn.addEventListener('click', async function() {
            if (isLoading) return;
            if (currentAccount) {
                disconnectWallet();
                return;
            }
            await connectWallet();
        });

        async function connectWallet() {
            if (!window.ethereum) {
                alert('请安装 MetaMask');
                return;
            }
            isLoading = true;
            connectBtn.disabled = true;
            connectBtn.innerHTML = '连接中<span class="loading-spinner"></span>';
            try {
                const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
                currentAccount = accounts[0];
                connectBtn.textContent = currentAccount.substring(0, 6) + '...' + currentAccount.substring(currentAccount.length - 4);
                connectBtn.classList.add('connected');
                connectBtn.disabled = false;
            } catch (e) {
                if (e.code === 4001) {
                    alert('请在 MetaMask 中授权连接');
                } else {
                    alert('连接失败: ' + (e.message || '未知错误'));
                }
                connectBtn.disabled = false;
                connectBtn.innerHTML = 'Connect wallet';
            } finally {
                isLoading = false;
            }
        }

        function disconnectWallet() {
            currentAccount = null;
            connectBtn.textContent = 'Connect wallet';
            connectBtn.classList.remove('connected');
            connectBtn.disabled = false;
        }

        async function autoConnect() {
            if (!window.ethereum) return;
            try {
                const accounts = await window.ethereum.request({ method: 'eth_accounts' });
                if (accounts && accounts.length > 0) {
                    currentAccount = accounts[0];
                    connectBtn.textContent = currentAccount.substring(0, 6) + '...' + currentAccount.substring(currentAccount.length - 4);
                    connectBtn.classList.add('connected');
                    connectBtn.disabled = false;
                }
            } catch (e) {}
        }
        setTimeout(() => autoConnect(), 500);

        // ======================== 详情弹窗 ========================
        function showDetail(icon, name, rarity, id, date, price) {
            document.getElementById('detailIcon').textContent = icon;
            document.getElementById('detailName').textContent = name;
            document.getElementById('detailRarity').textContent = rarity;
            document.getElementById('detailId').textContent = '编号：' + id;
            document.getElementById('detailDate').textContent = '获得日期：' + date;
            document.getElementById('detailPrice').textContent = price;
            document.getElementById('modalOverlay').classList.add('open');
        }

        function closeModal() {
            document.getElementById('modalOverlay').classList.remove('open');
        }

        document.getElementById('modalOverlay').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });

        function handleTransfer() {
            if (!currentAccount) {
                alert('请先连接钱包');
                return;
            }
            alert('📤 转赠功能 (演示模式)');
            closeModal();
        }

        function handleSell() {
            if (!currentAccount) {
                alert('请先连接钱包');
                return;
            }
            alert('💰 出售功能 (演示模式)');
            closeModal();
        }
    </script>
