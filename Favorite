<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>收藏 · 我的藏品</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/5.7.2/ethers.umd.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
        :root {
            --bg-color: #0d1a14; --gold-light: #f8ecc9; --gold-main: #d6b878;
            --gold-deep: #9e7a3a; --gold-glow: #dbb45c; --text-secondary: #b8a47b;
        }
        body {
            background-color: var(--bg-color); display: flex; justify-content: center; align-items: center;
            height: 100vh; height: 100dvh; overflow: hidden; position: fixed; top: 0; left: 0; right: 0; bottom: 0; color: #fff;
            background-image: radial-gradient(circle at 20% 10%, rgba(180,145,70,0.12) 0%, transparent 35%), radial-gradient(circle at 80% 80%, rgba(220,195,140,0.08) 0%, transparent 40%);
        }
        .app-container {
            width: 100%; max-width: 420px; height: 100%; background: radial-gradient(circle at 50% 10%, #1a2e1f 0%, #0d1a14 100%);
            border-radius: 20px; box-shadow: 0 0 40px rgba(180,145,70,0.15); display: flex; flex-direction: column; position: relative; overflow: hidden;
        }
        .scroll-area { flex: 1; overflow-y: auto; padding: 15px; -webkit-overflow-scrolling: touch; position: relative; z-index: 1; }
        .header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 15px; }
        .logo-area { display: flex; align-items: center; font-size: 18px; font-weight: 700; color: var(--gold-main); text-shadow: 0 0 15px rgba(180,145,70,0.4); }
        .logo-area span:first-child { font-size: 28px; margin-right: 8px; }
        .header-controls { display: flex; gap: 8px; align-items: center; position: relative; }
        .lang-btn { background: transparent; border: 1px solid rgba(180,145,70,0.25); color: var(--text-secondary); padding: 5px 10px; border-radius: 6px; font-size: 12px; cursor: pointer; }
        .lang-dropdown { display: none; position: absolute; top: 38px; right: 0; background: rgba(13,26,20,0.97); backdrop-filter: blur(12px); border: 1px solid rgba(180,145,70,0.25); border-radius: 12px; padding: 12px; width: 200px; box-shadow: 0 8px 32px rgba(0,0,0,0.8); z-index: 999; flex-direction: column; gap: 6px; max-height: 300px; overflow-y: auto; }
        .lang-dropdown.open { display: flex; }
        .lang-option { display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; border-radius: 6px; color: #f0e6d2; font-size: 14px; cursor: pointer; }
        .lang-option:hover { background: rgba(197,164,85,0.15); color: var(--gold-light); }
        .lang-option .code { color: var(--text-secondary); font-size: 12px; margin-left: 8px; }
        .connect-btn { background: transparent; border: 1px solid rgba(214,184,120,0.4); color: var(--gold-glow); padding: 6px 12px; border-radius: 20px; font-size: 12px; cursor: pointer; transition: all 0.3s; white-space: nowrap; }
        .connect-btn.connected { background: rgba(180,145,70,0.12); border-color: var(--gold-glow); color: var(--gold-light); }
        .page-title { text-align: center; margin-bottom: 20px; }
        .page-title h2 { font-size: 26px; font-weight: 700; background: linear-gradient(180deg, #f5e3b3 0%, #c5a455 60%, #8a6327 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; text-shadow: 0 0 20px rgba(180,145,70,0.5); margin-bottom: 6px; }
        .page-title p { color: #b8a16a; font-size: 13px; }
        .stats-panel { background: rgba(19,32,22,0.8); border: 1px solid rgba(180,145,70,0.25); border-radius: 14px; padding: 15px; margin-bottom: 15px; display: flex; justify-content: space-around; text-align: center; backdrop-filter: blur(8px); }
        .stat-item { flex: 1; }
        .stat-item .stat-value { color: var(--gold-light); font-size: 22px; font-weight: 700; }
        .stat-item .stat-label { color: var(--text-secondary); font-size: 11px; margin-top: 2px; }
        .stat-divider { width: 1px; background: rgba(180,145,70,0.2); }
        .collection-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .nft-card { background: rgba(19,32,22,0.8); border: 1px solid rgba(180,145,70,0.25); border-radius: 14px; padding: 12px; text-align: center; backdrop-filter: blur(8px); cursor: pointer; transition: all 0.3s; }
        .nft-card:hover { border-color: rgba(220,187,92,0.6); transform: translateY(-3px); }
        .nft-card .icon-frame { width: 100%; height: 90px; border-radius: 10px; background: linear-gradient(145deg, #1f2e22 0%, #0e1d13 100%); border: 1px solid rgba(212,175,85,0.3); display: flex; align-items: center; justify-content: center; font-size: 45px; margin-bottom: 8px; }
        .nft-card .name { color: white; font-size: 13px; font-weight: 600; }
        .nft-card .rarity-text { font-size: 11px; }
        .rarity-legendary { color: #ffb84d; } .rarity-epic { color: #d98eff; } .rarity-rare { color: #6db3ff; } .rarity-common { color: #ccc; }
        .bottom-nav { flex-shrink: 0; background: rgba(10,20,13,0.9); backdrop-filter: blur(12px); border: 1px solid rgba(180,145,70,0.2); border-radius: 20px; box-shadow: 0 -4px 30px rgba(0,0,0,0.8); display: flex; justify-content: space-around; padding: 12px 0; margin: 0 15px 15px 15px; position: relative; z-index: 10; }
        .bottom-nav::before { content: ''; position: absolute; top: -1px; left: -1px; right: -1px; bottom: -1px; border-radius: 20px; padding: 1px; background: linear-gradient(135deg, var(--gold-deep), transparent, var(--gold-light)); -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); -webkit-mask-composite: xor; mask-composite: exclude; pointer-events: none; opacity: 0.5; }
        .nav-item { display: flex; flex-direction: column; align-items: center; color: var(--text-secondary); font-size: 11px; gap: 4px; cursor: pointer; padding: 5px 10px; transition: all 0.3s; text-decoration: none; }
        .nav-item .nav-icon { font-size: 18px; }
        .nav-item.active { color: var(--gold-light); position: relative; }
        .nav-item.active::after { content: ''; position: absolute; top: -6px; left: 50%; transform: translateX(-50%); width: 20px; height: 2px; background: linear-gradient(to right, var(--gold-deep), var(--gold-glow)); border-radius: 5px; box-shadow: 0 0 15px var(--gold-glow); }
        .nav-item:not(.active):hover { color: var(--gold-glow); }
        .loading-spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid rgba(180,145,70,0.2); border-top: 2px solid var(--gold-glow); border-radius: 50%; animation: spin 0.6s linear infinite; margin-right: 4px; vertical-align: middle; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <div class="app-container">
        <div class="scroll-area">
            <div class="header">
                <div class="logo-area"><span>❤️</span><span>RARE ANIMAL</span></div>
                <div class="header-controls">
                    <button class="lang-btn" id="langBtn">🇨🇳 CN ⌄</button>
                    <div class="lang-dropdown" id="langDropdown">
                        <div class="lang-option" data-lang="cn"><span>🇨🇳 简体中文</span><span class="code">CN</span></div>
                        <div class="lang-option" data-lang="en"><span>🇺🇸 English</span><span class="code">EN</span></div>
                        <div class="lang-option" data-lang="zh"><span>🇭🇰 繁體中文</span><span class="code">ZH</span></div>
                    </div>
                    <button id="connectWalletBtn" class="connect-btn">Connect wallet</button>
                </div>
            </div>

            <div class="page-title">
                <h2>🗂️ 我的藏品</h2>
                <p>你的珍稀动物收藏库 · 墨绿鎏金典藏</p>
            </div>

            <div class="stats-panel">
                <div class="stat-item"><div class="stat-value">8</div><div class="stat-label">总藏品</div></div>
                <div class="stat-divider"></div>
                <div class="stat-item"><div class="stat-value">3</div><div class="stat-label">稀有以上</div></div>
                <div class="stat-divider"></div>
                <div class="stat-item"><div class="stat-value">2</div><div class="stat-label">传说</div></div>
                <div class="stat-divider"></div>
                <div class="stat-item"><div class="stat-value">4.8</div><div class="stat-label">估值 BNB</div></div>
            </div>

            <div class="collection-grid">
                <div class="nft-card" onclick="alert('🐅 雪豹 · 传说 · #0001')"><div class="icon-frame">🐅</div><div class="name">雪豹</div><div class="rarity-text rarity-legendary">传说</div></div>
                <div class="nft-card" onclick="alert('🐼 大熊猫 · 传说 · #0007')"><div class="icon-frame">🐼</div><div class="name">大熊猫</div><div class="rarity-text rarity-legendary">传说</div></div>
                <div class="nft-card" onclick="alert('🦏 白犀牛 · 史诗 · #0892')"><div class="icon-frame">🦏</div><div class="name">白犀牛</div><div class="rarity-text rarity-epic">史诗</div></div>
                <div class="nft-card" onclick="alert('🦅 金雕 · 稀有 · #2210')"><div class="icon-frame">🦅</div><div class="name">金雕</div><div class="rarity-text rarity-rare">稀有</div></div>
                <div class="nft-card" onclick="alert('🐘 亚洲象 · 稀有 · #1502')"><div class="icon-frame">🐘</div><div class="name">亚洲象</div><div class="rarity-text rarity-rare">稀有</div></div>
                <div class="nft-card" onclick="alert('🐯 孟加拉虎 · 稀有 · #1024')"><div class="icon-frame">🐯</div><div class="name">孟加拉虎</div><div class="rarity-text rarity-rare">稀有</div></div>
                <div class="nft-card" onclick="alert('🦊 藏狐 · 普通 · #2451')"><div class="icon-frame">🦊</div><div class="name">藏狐</div><div class="rarity-text rarity-common">普通</div></div>
                <div class="nft-card" onclick="alert('🦌 麋鹿 · 普通 · #3120')"><div class="icon-frame">🦌</div><div class="name">麋鹿</div><div class="rarity-text rarity-common">普通</div></div>
            </div>
        </div>

        <div class="bottom-nav">
            <a href="index.html" class="nav-item"><i class="fas fa-gem nav-icon"></i><span>挑选NFT</span></a>
            <a href="entertainment.html" class="nav-item"><i class="fas fa-gamepad nav-icon"></i><span>娱乐</span></a>
            <a href="market.html" class="nav-item"><i class="fas fa-store nav-icon"></i><span>市场</span></a>
            <a href="favorite.html" class="nav-item active"><i class="fas fa-heart nav-icon"></i><span>收藏</span></a>
            <a href="ecosystem.html" class="nav-item"><i class="fas fa-globe nav-icon"></i><span>生态</span></a>
        </div>
    </div>

    <script>
        const langBtn = document.getElementById('langBtn');
        const langDropdown = document.getElementById('langDropdown');
        langBtn.addEventListener('click', (e) => { e.stopPropagation(); langDropdown.classList.toggle('open'); });
        document.addEventListener('click', (e) => { if (!langDropdown.contains(e.target)) langDropdown.classList.remove('open'); });
        document.querySelectorAll('.lang-option').forEach(option => {
            option.addEventListener('click', function() {
                localStorage.setItem('bcbsLang', this.getAttribute('data-lang'));
                langDropdown.classList.remove('open');
            });
        });
        const connectBtn = document.getElementById('connectWalletBtn');
        let currentAccount = null;
        connectBtn.addEventListener('click', async function() {
            if (currentAccount) { currentAccount = null; connectBtn.textContent = 'Connect wallet'; connectBtn.classList.remove('connected'); return; }
            if (!window.ethereum) { alert('请安装 MetaMask'); return; }
            connectBtn.innerHTML = '连接中<span class="loading-spinner"></span>';
            try {
                const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
                currentAccount = accounts[0];
                connectBtn.textContent = currentAccount.substring(0, 6) + '...' + currentAccount.substring(currentAccount.length - 4);
                connectBtn.classList.add('connected');
            } catch (e) { connectBtn.innerHTML = 'Connect wallet'; }
        });
        (async () => { if (window.ethereum) { try { const a = await window.ethereum.request({ method: 'eth_accounts' }); if (a.length > 0) { currentAccount = a[0]; connectBtn.textContent = currentAccount.substring(0, 6) + '...' + currentAccount.substring(currentAccount.length - 4); connectBtn.classList.add('connected'); } } catch (e) {} } })();
    </script>
</body>
</html>
