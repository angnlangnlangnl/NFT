<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>收藏 · 我的藏品</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/5.7.2/ethers.umd.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        :root {
            --bg-color: #0d1a14;
            --card-bg: rgba(19, 32, 22, 0.85);
            --border-color: rgba(180, 145, 70, 0.25);
            --text-primary: #FFFFFF;
            --text-primary-soft: #f0e6d2;
            --text-secondary: #b8a47b;
            --gold-light: #f8ecc9;
            --gold-main: #d6b878;
            --gold-deep: #9e7a3a;
            --gold-glow: #dbb45c;
        }

        body {
            background-color: var(--bg-color);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            height: 100dvh;
            overflow: hidden;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            color: var(--text-primary);
            background-image: 
                radial-gradient(circle at 20% 10%, rgba(180, 145, 70, 0.12) 0%, transparent 35%),
                radial-gradient(circle at 80% 80%, rgba(220, 195, 140, 0.08) 0%, transparent 40%);
        }

        .app-container {
            width: 100%;
            max-width: 420px;
            height: 100%;
            max-height: 100vh;
            max-height: 100dvh;
            background: radial-gradient(circle at 50% 10%, #1a2e1f 0%, #0d1a14 100%);
            border-radius: 20px;
            box-shadow: 0 0 40px rgba(180, 145, 70, 0.15);
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
        }

        .app-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: radial-gradient(rgba(180, 145, 70, 0.06) 1px, transparent 1px);
            background-size: 40px 40px;
            opacity: 0.5;
            z-index: 0;
            pointer-events: none;
            border-radius: 20px;
        }

        .scroll-area {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
            -webkit-overflow-scrolling: touch;
            overscroll-behavior: contain;
            position: relative;
            z-index: 1;
        }

        /* 头部样式 */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 15px;
            position: relative;
        }

        .logo-area {
            display: flex;
            align-items: center;
            font-size: 18px;
            font-weight: 700;
            color: var(--gold-main);
            letter-spacing: 0.5px;
            text-shadow: 0 0 15px rgba(180, 145, 70, 0.4);
        }

        .logo-area .logo-icon {
            font-size: 28px;
            margin-right: 8px;
        }

        .header-controls {
            display: flex;
            gap: 8px;
            align-items: center;
            position: relative;
        }

        .lang-btn {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .lang-btn.active {
            background: rgba(180, 145, 70, 0.1);
            border-color: var(--gold-main);
            color: var(--gold-glow);
        }

        .lang-dropdown {
            display: none;
            position: absolute;
            top: 38px;
            right: 0;
            background: rgba(13, 26, 20, 0.97);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 12px;
            width: 200px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.8);
            z-index: 999;
            flex-direction: column;
            gap: 6px;
            max-height: 300px;
            overflow-y: auto;
        }

        .lang-dropdown.open {
            display: flex;
        }

        .lang-option {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            border-radius: 6px;
            color: var(--text-primary-soft);
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .lang-option:hover {
            background: rgba(197, 164, 85, 0.15);
            color: var(--gold-light);
        }

        .lang-option .code {
            color: var(--text-secondary);
            font-size: 12px;
            font-weight: 500;
            margin-left: 8px;
        }

        .connect-btn {
            background: transparent;
            border: 1px solid rgba(214, 184, 120, 0.4);
            color: var(--gold-glow);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            box-shadow: 0 0 15px rgba(180, 145, 70, 0.08);
            transition: all 0.3s;
            white-space: nowrap;
        }

        .connect-btn:hover:not(:disabled) {
            box-shadow: 0 0 25px rgba(180, 145, 70, 0.25);
            background: rgba(180, 145, 70, 0.08);
        }

        .connect-btn.connected {
            background: rgba(180, 145, 70, 0.12);
            border-color: var(--gold-glow);
            color: var(--gold-light);
        }

        .connect-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* 页面标题 */
        .page-title {
            text-align: center;
            margin-bottom: 20px;
        }

        .page-title h2 {
            font-size: 26px;
            font-weight: 700;
            background: linear-gradient(180deg, #f5e3b3 0%, #c5a455 60%, #8a6327 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 0 20px rgba(180, 145, 70, 0.5);
            margin-bottom: 6px;
        }

        .page-title p {
            color: #b8a16a;
            font-size: 13px;
            line-height: 1.5;
        }

        /* 统计面板 */
        .stats-panel {
            background: rgba(19, 32, 22, 0.8);
            border: 1px solid rgba(180, 145, 70, 0.25);
            border-radius: 14px;
            padding: 15px;
            margin-bottom: 15px;
            display: flex;
            justify-content: space-around;
            text-align: center;
            backdrop-filter: blur(8px);
        }

        .stat-item {
            flex: 1;
        }

        .stat-item .stat-value {
            color: var(--gold-light);
            font-size: 22px;
            font-weight: 700;
        }

        .stat-item .stat-label {
            color: var(--text-secondary);
            font-size: 11px;
            margin-top: 2px;
        }

        .stat-divider {
            width: 1px;
            background: rgba(180, 145, 70, 0.2);
        }

        /* 排序和视图切换 */
        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .toolbar .section-title {
            color: var(--gold-light);
            font-size: 16px;
            font-weight: 600;
        }

        .toolbar .view-options {
            display: flex;
            gap: 6px;
        }

        .view-btn {
            background: rgba(19, 32, 22, 0.7);
            border: 1px solid rgba(180, 145, 70, 0.25);
            color: var(--text-secondary);
            padding: 5px 10px;
            border-radius: 8px;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .view-btn.active {
            background: rgba(180, 145, 70, 0.15);
            border-color: var(--gold-glow);
            color: var(--gold-glow);
        }

        /* 藏品网格视图 */
        .collection-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .nft-card {
            background: rgba(19, 32, 22, 0.8);
            border: 1px solid rgba(180, 145, 70, 0.25);
            border-radius: 14px;
            padding: 12px;
            text-align: center;
            backdrop-filter: blur(8px);
            transition: all 0.3s;
            cursor: pointer;
            position: relative;
        }

        .nft-card:hover {
            border-color: rgba(220, 187, 92, 0.6);
            box-shadow: 0 6px 20px rgba(180, 145, 70, 0.2);
            transform: translateY(-3px);
        }

        .nft-card .icon-frame {
            width: 100%;
            height: 100px;
            border-radius: 10px;
            background: linear-gradient(145deg, #1f2e22 0%, #0e1d13 100%);
            border: 1px solid rgba(212, 175, 85, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 50px;
            margin-bottom: 10px;
            position: relative;
            overflow: hidden;
        }

        .nft-card .icon-frame .shimmer {
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.04), transparent);
            animation: shimmer 3s infinite;
        }

        @keyframes shimmer {
            0% { left: -100%; }
            100% { left: 100%; }
        }

        .nft-card .rarity-badge {
            position: absolute;
            top: 6px;
            left: 6px;
            padding: 2px 8px;
            border-radius: 8px;
            font-size: 9px;
            font-weight: 600;
            z-index: 1;
        }

        .rarity-common { background: rgba(150,150,150,0.3); color: #ccc; }
        .rarity-rare { background: rgba(66,133,244,0.3); color: #6db3ff; }
        .rarity-epic { background: rgba(180,70,200,0.3); color: #d98eff; }
        .rarity-legendary { background: rgba(255,170,40,0.3); color: #ffb84d; }

        .nft-card .name {
            color: white;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .nft-card .rarity-text {
            font-size: 11px;
            margin-bottom: 4px;
        }

        .nft-card .id-text {
            color: rgba(255,255,255,0.4);
            font-size: 10px;
        }

        /* 藏品列表视图 */
        .collection-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .nft-list-item {
            background: rgba(19, 32, 22, 0.8);
            border: 1px solid rgba(180, 145, 70, 0.25);
            border-radius: 12px;
            padding: 10px 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            backdrop-filter: blur(8px);
            transition: all 0.2s;
            cursor: pointer;
        }

        .nft-list-item:hover {
            border-color: rgba(220, 187, 92, 0.5);
            box-shadow: 0 4px 15px rgba(180, 145, 70, 0.15);
        }

        .nft-list-item .list-icon {
            font-size: 35px;
            width: 45px;
            text-align: center;
        }

        .nft-list-item .list-info {
            flex: 1;
        }

        .nft-list-item .list-name {
            color: white;
            font-weight: 600;
            font-size: 14px;
        }

        .nft-list-item .list-rarity {
            font-size: 11px;
        }

        .nft-list-item .list-id {
            color: rgba(255,255,255,0.4);
            font-size: 10px;
        }

        .nft-list-item .list-arrow {
            color: var(--gold-glow);
            font-size: 14px;
        }

        /* 详情弹窗 */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.9);
            z-index: 100;
            justify-content: center;
            align-items: center;
        }

        .modal-overlay.open {
            display: flex;
        }

        .modal-box {
            background: linear-gradient(145deg, #1a2e1f, #0d1a14);
            border: 2px solid var(--gold-glow);
            border-radius: 20px;
            padding: 25px;
            text-align: center;
            max-width: 320px;
            width: 90%;
            box-shadow: 0 0 60px rgba(180, 145, 70, 0.5);
        }

        .modal-box .detail-icon {
            font-size: 80px;
            animation: bounceIn 0.5s ease;
        }

        @keyframes bounceIn {
            0% { transform: scale(0); opacity: 0; }
            50% { transform: scale(1.2); }
            100% { transform: scale(1); opacity: 1; }
        }

        .modal-box .detail-name {
            color: var(--gold-light);
            font-size: 22px;
            font-weight: 700;
            margin: 15px 0 5px;
        }

        .modal-box .detail-rarity {
            font-size: 14px;
            margin-bottom: 8px;
        }

        .modal-box .detail-info {
            color: var(--text-secondary);
            font-size: 12px;
            margin-bottom: 4px;
        }

        .modal-box .detail-date {
            color: rgba(255,255,255,0.5);
            font-size: 11px;
            margin: 10px 0;
        }

        .modal-box .btn-row {
            display: flex;
            gap: 8px;
            justify-content: center;
            margin-top: 15px;
        }

        .modal-box .btn-primary {
            padding: 10px 25px;
            background: linear-gradient(180deg, #e7c778 0%, #b48b3a 100%);
            color: #0a130e;
            border: none;
            border-radius: 25px;
            font-weight: 700;
            cursor: pointer;
            font-size: 14px;
        }

        .modal-box .btn-secondary {
            padding: 10px 25px;
            background: transparent;
            border: 1px solid var(--gold-glow);
            color: var(--gold-glow);
            border-radius: 25px;
            cursor: pointer;
            font-size: 13px;
        }

        /* 空状态 */
        .empty-state {
            text-align: center;
            padding: 40px 20px;
        }

        .empty-state .empty-icon {
            font-size: 60px;
            opacity: 0.5;
            margin-bottom: 15px;
        }

        .empty-state .empty-text {
            color: var(--text-secondary);
            font-size: 14px;
            margin-bottom: 5px;
        }

        .empty-state .empty-hint {
            color: rgba(255,255,255,0.3);
            font-size: 12px;
        }

        .loading-spinner {
            display: inline-block;
            width: 14px;
            height: 14px;
            border: 2px solid rgba(180, 145, 70, 0.2);
            border-top: 2px solid var(--gold-glow);
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
            margin-right: 4px;
            vertical-align: middle;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* 底部导航 */
        .bottom-nav {
            flex-shrink: 0;
            background: rgba(10, 20, 13, 0.9);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(180, 145, 70, 0.2);
            border-radius: 20px;
            box-shadow: 0 -4px 30px rgba(0, 0, 0, 0.8);
            display: flex;
            justify-content: space-around;
            padding: 12px 0;
            margin: 0 15px 15px 15px;
            position: relative;
            z-index: 10;
        }

        .bottom-nav::before {
            content: '';
            position: absolute;
            top: -1px;
            left: -1px;
            right: -1px;
            bottom: -1px;
            border-radius: 20px;
            padding: 1px;
            background: linear-gradient(135deg, var(--gold-deep), transparent, var(--gold-light));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
            opacity: 0.5;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: var(--text-secondary);
            font-size: 11px;
            gap: 4px;
            cursor: pointer;
            padding: 5px 10px;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .nav-item .nav-icon {
            font-size: 18px;
        }

        .nav-item.active {
            color: var(--gold-light);
            position: relative;
        }

        .nav-item.active::after {
            content: '';
            position: absolute;
            top: -6px;
            left: 50%;
            transform: translateX(-50%);
            width: 20px;
            height: 2px;
            background: linear-gradient(to right, var(--gold-deep), var(--gold-glow));
            border-radius: 5px;
            box-shadow: 0 0 15px var(--gold-glow);
        }

        .nav-item:not(.active):hover {
            color: var(--gold-glow);
        }
    </style>
</head>
<body>
    <div class="app-container">
        <div class="scroll-area">
            <!-- 头部 -->
            <div class="header">
                <div class="logo-area">
                    <span class="logo-icon">❤️</span>
                    <span>RARE ANIMAL</span>
                </div>
                <div class="header-controls">
                    <button class="lang-btn" id="langBtn">🇨🇳 CN ⌄</button>
                    <div class="lang-dropdown" id="langDropdown">
                        <div class="lang-option" data-lang="cn"><span>🇨🇳 简体中文</span><span class="code">CN</span></div>
                        <div class="lang-option" data-lang="en"><span>🇺🇸 English</span><span class="code">EN</span></div>
                        <div class="lang-option" data-lang="zh"><span>🇭🇰 繁體中文</span><span class="code">ZH</span></div>
                        <div class="lang-option" data-lang="es"><span>🇪🇸 Español</span><span class="code">ES</span></div>
                        <div class="lang-option" data-lang="fr"><span>🇫🇷 Français</span><span class="code">FR</span></div>
                        <div class="lang-option" data-lang="ko"><span>🇰🇷 한국어</span><span class="code">KO</span></div>
                        <div class="lang-option" data-lang="ja"><span>🇯🇵 日本語</span><span class="code">JA</span></div>
                        <div class="lang-option" data-lang="ar"><span>🇸🇦 العربية</span><span class="code">AR</span></div>
                        <div class="lang-option" data-lang="ru"><span>🇷🇺 Русский</span><span class="code">RU</span></div>
                    </div>
                    <button id="connectWalletBtn" class="connect-btn">Connect wallet</button>
                </div>
            </div>

            <!-- 页面标题 -->
            <div class="page-title">
                <h2>🗂️ 我的藏品</h2>
                <p>你的珍稀动物收藏库 · 墨绿鎏金典藏</p>
            </div>

            <!-- 统计面板 -->
            <div class="stats-panel">
                <div class="stat-item">
                    <div class="stat-value" id="totalCount">8</div>
                    <div class="stat-label stat-total">总藏品</div>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <div class="stat-value" id="rareCount">3</div>
                    <div class="stat-label stat-rare">稀有以上</div>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <div class="stat-value" id="legendaryCount">2</div>
                    <div class="stat-label stat-legendary">传说</div>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <div class="stat-value" id="totalValue">4.8</div>
                    <div class="stat-label stat-value-label">估值 BNB</div>
                </div>
            </div>

            <!-- 工具栏 -->
            <div class="toolbar">
                <span class="section-title collection-list-title">藏品列表</span>
                <div class="view-options">
                    <button class="view-btn active" onclick="switchView('grid', this)">
                        <i class="fas fa-th-large"></i>
                    </button>
                    <button class="view-btn" onclick="switchView('list', this)">
                        <i class="fas fa-list"></i>
                    </button>
                </div>
            </div>

            <!-- 藏品网格视图 -->
            <div class="collection-grid" id="gridView">
                <!-- 传说 -->
                <div class="nft-card" onclick="showDetail('🐅', '雪豹', '传说', '#0001', '2026-07-20', '2.5 BNB')">
                    <div class="icon-frame">
                        <div class="shimmer"></div>
                        <span class="rarity-badge rarity-legendary">传说</span>
                        🐅
                    </div>
                    <div class="name">雪豹</div>
                    <div class="rarity-text" style="color:#ffb84d;">传说</div>
                    <div class="id-text">#0001</div>
                </div>

                <div class="nft-card" onclick="showDetail('🐼', '大熊猫', '传说', '#0007', '2026-07-18', '3.0 BNB')">
                    <div class="icon-frame">
                        <div class="shimmer"></div>
                        <span class="rarity-badge rarity-legendary">传说</span>
                        🐼
                    </div>
                    <div class="name">大熊猫</div>
                    <div class="rarity-text" style="color:#ffb84d;">传说</div>
                    <div class="id-text">#0007</div>
                </div>

                <!-- 史诗 -->
                <div class="nft-card" onclick="showDetail('🦏', '白犀牛', '史诗', '#0892', '2026-07-15', '0.45 BNB')">
                    <div class="icon-frame">
                        <div class="shimmer"></div>
                        <span class="rarity-badge rarity-epic">史诗</span>
                        🦏
                    </div>
                    <div class="name">白犀牛</div>
                    <div class="rarity-text" style="color:#d98eff;">史诗</div>
                    <div class="id-text">#0892</div>
                </div>

                <!-- 稀有 -->
                <div class="nft-card" onclick="showDetail('🦅', '金雕', '稀有', '#2210', '2026-07-12', '0.08 BNB')">
                    <div class="icon-frame">
                        <div class="shimmer"></div>
                        <span class="rarity-badge rarity-rare">稀有</span>
                        🦅
                    </div>
                    <div class="name">金雕</div>
                    <div class="rarity-text" style="color:#6db3ff;">稀有</div>
                    <div class="id-text">#2210</div>
                </div>

                <div class="nft-card" onclick="showDetail('🐘', '亚洲象', '稀有', '#1502', '2026-07-10', '0.07 BNB')">
                    <div class="icon-frame">
                        <div class="shimmer"></div>
                        <span class="rarity-badge rarity-rare">稀有</span>
                        🐘
                    </div>
                    <div class="name">亚洲象</div>
                    <div class="rarity-text" style="color:#6db3ff;">稀有</div>
